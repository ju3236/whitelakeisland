<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>백하고등학교 — 생존자 관리</title>
<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700;900&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<style>
/* ══════════════════════════════════
   TOKENS
══════════════════════════════════ */
*{box-sizing:border-box;margin:0;padding:0;}
:root{
  /* 배경 */
  --bg:       #f2f0eb;
  --surf:     #ffffff;
  --lift:     #f8f7f4;
  --panel:    #f0ede6;
  /* 테두리 */
  --bord:     #dedad2;
  --bord2:    #c8c3b8;
  /* 텍스트 */
  --tx:       #1c1a16;
  --txs:      #5a5448;
  --txm:      #8a8278;
  --txw:      #b8b2a8;
  /* 메인 컬러 — 올리브 그린 */
  --g:        #4a7c2f;
  --gl:       #5e9838;
  --gll:      #7ab84a;
  --gx:       #c8e8a0;
  --gbg:      #f0f8e8;
  /* 레드 */
  --r:        #b83030;
  --rl:       #d04040;
  --rbg:      #fdf0f0;
  /* 앰버 */
  --a:        #a06010;
  --al:       #c07818;
  --abg:      #fdf6ec;
  /* 블루 */
  --b:        #2858a0;
  --bl:       #3870c0;
  --bbg:      #eff5fd;
  /* 퍼플 */
  --p:        #7040a8;
  --pl:       #8c54c4;
  --pbg:      #f6f0fd;
  /* 폰트 */
  --fn: 'Noto Sans KR', sans-serif;
  --fm: 'Share Tech Mono', monospace;
  /* 레이어 */
  --sh: 0 1px 3px rgba(0,0,0,.08), 0 4px 12px rgba(0,0,0,.06);
  --sh2: 0 2px 8px rgba(0,0,0,.1), 0 8px 24px rgba(0,0,0,.08);
}

html,body{height:100%;background:var(--bg);font-family:var(--fn);color:var(--tx);overflow:hidden;}

/* 스크롤바 */
::-webkit-scrollbar{width:5px;height:5px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--bord2);border-radius:3px;}
::-webkit-scrollbar-thumb:hover{background:var(--txm);}

/* ══════════════════════════════════
   LAYOUT — 사이드바 + 메인
══════════════════════════════════ */
.app{display:flex;height:100vh;overflow:hidden;}

/* ── SIDEBAR ── */
.sidebar{
  width:220px;flex-shrink:0;
  background:var(--tx);
  display:flex;flex-direction:column;
  overflow:hidden;
}
.sb-header{
  padding:20px 18px 16px;
  border-bottom:1px solid rgba(255,255,255,.08);
}
.sb-logo{
  font-family:var(--fm);font-size:11px;letter-spacing:3px;
  color:rgba(255,255,255,.35);text-transform:uppercase;margin-bottom:6px;
}
.sb-title{
  font-size:17px;font-weight:900;color:#fff;letter-spacing:-.3px;line-height:1.2;
}
.sb-title em{color:var(--gll);font-style:normal;}
.sb-status{
  display:flex;align-items:center;gap:5px;margin-top:8px;
  font-family:var(--fm);font-size:10px;color:rgba(255,255,255,.4);
}
.sb-dot{width:5px;height:5px;border-radius:50%;background:var(--gll);animation:pulse 2s infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.3;}}

.sb-nav{flex:1;overflow-y:auto;padding:10px 0;}
.sb-section{
  font-family:var(--fm);font-size:9px;letter-spacing:2px;
  color:rgba(255,255,255,.25);text-transform:uppercase;
  padding:12px 18px 5px;
}
.sb-item{
  display:flex;align-items:center;gap:10px;
  padding:9px 18px;cursor:pointer;
  font-size:13px;font-weight:500;color:rgba(255,255,255,.55);
  transition:all .15s;border:none;background:none;width:100%;text-align:left;
  position:relative;
}
.sb-item:hover{color:#fff;background:rgba(255,255,255,.06);}
.sb-item.on{color:#fff;background:rgba(255,255,255,.1);}
.sb-item.on::before{
  content:'';position:absolute;left:0;top:0;bottom:0;width:3px;
  background:var(--gll);border-radius:0 2px 2px 0;
}
.sb-icon{
  width:30px;height:30px;border-radius:6px;
  display:flex;align-items:center;justify-content:center;
  font-size:14px;flex-shrink:0;
  background:rgba(255,255,255,.06);
}
.sb-item.on .sb-icon{background:var(--g);}
.sb-badge{
  margin-left:auto;font-family:var(--fm);font-size:9px;
  background:rgba(255,255,255,.1);border-radius:10px;
  padding:2px 7px;color:rgba(255,255,255,.4);
}
.sb-item.on .sb-badge{background:var(--g);color:#fff;}

.sb-footer{
  padding:14px 18px;border-top:1px solid rgba(255,255,255,.08);
  font-family:var(--fm);font-size:9px;color:rgba(255,255,255,.25);
  line-height:1.6;
}

/* ── MAIN ── */
.main{flex:1;overflow:hidden;display:flex;flex-direction:column;}

.topbar{
  background:var(--surf);border-bottom:1px solid var(--bord);
  padding:0 24px;height:52px;
  display:flex;align-items:center;justify-content:space-between;
  flex-shrink:0;
}
.topbar-left{display:flex;align-items:center;gap:8px;}
.page-title{font-size:16px;font-weight:700;color:var(--tx);}
.page-sub{font-size:12px;color:var(--txm);font-family:var(--fm);}
.topbar-right{display:flex;align-items:center;gap:8px;}
.stat-chip{
  font-family:var(--fm);font-size:10px;
  background:var(--lift);border:1px solid var(--bord);
  border-radius:4px;padding:4px 10px;color:var(--txs);
}

.content{flex:1;overflow-y:auto;padding:20px 24px;}
.tab{display:none;}.tab.on{display:block;}

/* ══════════════════════════════════
   SHARED COMPONENTS
══════════════════════════════════ */
/* 섹션 헤더 */
.sec{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px;}
.sec-title{font-size:13px;font-weight:700;color:var(--txs);letter-spacing:.5px;text-transform:uppercase;}
.sec-line{flex:1;height:1px;background:var(--bord);margin-left:10px;}

/* 버튼 */
.btn{
  font-family:var(--fn);font-size:12px;font-weight:700;
  padding:7px 16px;border-radius:6px;cursor:pointer;
  transition:all .15s;border:none;display:inline-flex;align-items:center;gap:5px;
}
.btn-p{background:var(--g);color:#fff;}
.btn-p:hover{background:var(--gl);}
.btn-s{background:var(--lift);color:var(--txs);border:1px solid var(--bord);}
.btn-s:hover{border-color:var(--g);color:var(--g);}
.btn-d{background:var(--rbg);color:var(--r);border:1px solid rgba(184,48,48,.2);}
.btn-d:hover{border-color:var(--r);}
.btn-sm{
  font-size:11px;font-weight:600;padding:4px 10px;border-radius:5px;
  cursor:pointer;transition:all .15s;border:1px solid var(--bord);
  background:var(--lift);color:var(--txs);font-family:var(--fn);
}
.btn-sm:hover{border-color:var(--g);color:var(--g);}
.btn-sm.g{border-color:rgba(74,124,47,.3);color:var(--g);background:var(--gbg);}
.btn-sm.g:hover{border-color:var(--g);background:#e8f8d8;}
.btn-sm.d{border-color:rgba(184,48,48,.2);color:var(--r);background:var(--rbg);}
.btn-sm.d:hover{border-color:var(--r);}

/* 폼 */
.fg{margin-bottom:11px;}
.fg label{display:block;font-size:11px;font-weight:700;color:var(--txs);margin-bottom:4px;letter-spacing:.3px;}
.fg input,.fg select,.fg textarea{
  width:100%;background:#fff;border:1.5px solid var(--bord);border-radius:7px;
  color:var(--tx);font-family:var(--fn);font-size:13px;
  padding:8px 11px;outline:none;transition:border-color .15s;
}
.fg input:focus,.fg select:focus,.fg textarea:focus{border-color:var(--g);}
.fg select option{background:#fff;}
.fg textarea{resize:vertical;min-height:60px;line-height:1.5;}
.fgr{display:grid;grid-template-columns:1fr 1fr;gap:9px;}

/* 오버레이 */
.overlay{
  display:none;position:fixed;inset:0;background:rgba(28,26,22,.6);
  z-index:200;align-items:center;justify-content:center;padding:20px;
  overflow-y:auto;
}
.overlay.open{display:flex;}
.modal{
  background:#fff;border-radius:12px;padding:24px;
  width:440px;max-width:100%;margin:auto;
  box-shadow:0 20px 60px rgba(0,0,0,.2);
  max-height:90vh;overflow-y:auto;
}
.modal h3{font-size:17px;font-weight:900;color:var(--tx);margin-bottom:16px;letter-spacing:-.3px;}
.mact{display:flex;gap:8px;margin-top:16px;}

/* 토스트 */
.toast{
  position:fixed;bottom:24px;right:24px;z-index:300;
  background:var(--tx);color:#fff;
  border-radius:8px;padding:11px 18px;
  font-size:13px;font-weight:500;
  box-shadow:var(--sh2);
  transform:translateY(16px);opacity:0;
  transition:all .25s;pointer-events:none;
}
.toast.show{transform:translateY(0);opacity:1;}
.toast.err{background:var(--r);}

/* 희귀도 */
.rar-common   {border-left:3px solid var(--txw) !important;}
.rar-uncommon {border-left:3px solid var(--g)  !important;}
.rar-rare     {border-left:3px solid var(--b)  !important;}
.rar-epic     {border-left:3px solid var(--p)  !important;}
.rar-legendary{border-left:3px solid var(--a)  !important;}
.rar-badge{font-family:var(--fm);font-size:9px;font-weight:700;letter-spacing:.5px;padding:1px 6px;border-radius:3px;}
.rb-common   {background:#f0ede6;color:var(--txw);}
.rb-uncommon {background:var(--gbg);color:var(--g);}
.rb-rare     {background:var(--bbg);color:var(--b);}
.rb-epic     {background:var(--pbg);color:var(--p);}
.rb-legendary{background:var(--abg);color:var(--a);}

/* ══════════════════════════════════
   캐릭터 탭
══════════════════════════════════ */
.cgrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:14px;}

.ccard{
  background:#fff;border-radius:10px;border:1.5px solid var(--bord);
  overflow:hidden;box-shadow:var(--sh);
  transition:box-shadow .2s, border-color .2s;
}
.ccard:hover{box-shadow:var(--sh2);border-color:var(--bord2);}

.ccard-stripe{height:4px;background:var(--cbar,var(--g));}

.ccard-body{padding:14px 16px 12px;}
.ccard-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:12px;}
.cname{font-size:18px;font-weight:900;color:var(--tx);letter-spacing:-.3px;line-height:1.1;}
.cplayer{font-family:var(--fm);font-size:10px;color:var(--txm);margin-top:2px;}
.crole-badge{
  font-size:11px;font-weight:700;padding:3px 10px;border-radius:20px;
  white-space:nowrap;flex-shrink:0;
}

/* 스탯 5점 도트 */
.stats{display:grid;grid-template-columns:1fr 1fr;gap:8px 14px;}
.stat-row{display:flex;flex-direction:column;gap:3px;}
.stat-top{display:flex;justify-content:space-between;align-items:baseline;}
.stat-name{font-family:var(--fm);font-size:10px;color:var(--txm);letter-spacing:.5px;}
.stat-num{font-size:13px;font-weight:900;}
.stat-dots{display:flex;gap:3px;}
.dot5{
  width:11px;height:11px;border-radius:50%;
  border:1.5px solid var(--bord2);background:#fff;
  transition:all .2s;
}
.dot5.on{border-color:transparent;}
.dot5.hp.on  {background:var(--r);}
.dot5.san.on {background:var(--b);}
.dot5.str.on {background:var(--g);}
.dot5.spd.on {background:var(--a);}

/* 인벤토리 */
.cinv{background:var(--lift);border-top:1px solid var(--bord);padding:10px 16px;}
.cinv-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:7px;}
.cinv-lbl{font-family:var(--fm);font-size:10px;color:var(--txm);letter-spacing:1px;}
.cinv-count{font-family:var(--fm);font-size:10px;color:var(--g);font-weight:700;}
.cinv-slots{display:flex;flex-wrap:wrap;gap:4px;min-height:22px;}
.inv-tag{
  font-family:var(--fm);font-size:9px;
  background:#fff;border:1px solid var(--bord);border-radius:4px;
  padding:2px 7px;color:var(--txs);
  display:flex;align-items:center;gap:3px;
}
.inv-tag .qty{color:var(--g);font-weight:700;}
.inv-empty{font-size:11px;color:var(--txw);font-style:italic;}

.ccard-foot{
  padding:8px 16px;border-top:1px solid var(--bord);
  background:#fff;display:flex;gap:6px;
}

.add-char-btn{
  background:#fff;border:1.5px dashed var(--bord2);border-radius:10px;
  color:var(--txm);font-size:14px;font-weight:700;
  cursor:pointer;min-height:150px;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;
  transition:all .18s;
}
.add-char-btn:hover{border-color:var(--g);color:var(--g);background:var(--gbg);}
.add-char-btn .plus{font-size:28px;font-weight:300;line-height:1;}

/* ══════════════════════════════════
   아이템 탭
══════════════════════════════════ */
.item-toolbar{display:flex;gap:8px;margin-bottom:12px;flex-wrap:wrap;align-items:center;}
.isrch{
  flex:1;min-width:130px;
  background:#fff;border:1.5px solid var(--bord);border-radius:7px;
  color:var(--tx);font-family:var(--fn);font-size:13px;
  padding:7px 12px;outline:none;transition:border-color .15s;
}
.isrch:focus{border-color:var(--g);}
.flt-btn{
  font-size:11px;font-weight:700;padding:7px 13px;border-radius:6px;
  cursor:pointer;border:1.5px solid var(--bord);background:#fff;
  color:var(--txs);transition:all .15s;
}
.flt-btn:hover{border-color:var(--g);color:var(--g);}
.flt-btn.on{background:var(--g);color:#fff;border-color:var(--g);}
.isort{
  background:#fff;border:1.5px solid var(--bord);border-radius:7px;
  color:var(--tx);font-family:var(--fn);font-size:12px;
  padding:7px 10px;outline:none;cursor:pointer;
}
.icount-txt{font-family:var(--fm);font-size:11px;color:var(--txm);}

.igrid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px;}

.icard{
  background:#fff;border:1.5px solid var(--bord);border-radius:9px;
  padding:12px 10px 10px;cursor:pointer;
  display:flex;flex-direction:column;align-items:center;gap:6px;
  position:relative;
  box-shadow:var(--sh);
  transition:all .18s;
}
.icard:hover{box-shadow:var(--sh2);transform:translateY(-2px);border-color:var(--bord2);}
.icard canvas{image-rendering:pixelated;width:56px;height:56px;}
.icard-name{font-size:12px;font-weight:700;color:var(--tx);text-align:center;line-height:1.2;}
.icard-type{font-family:var(--fm);font-size:9px;color:var(--txm);text-transform:uppercase;letter-spacing:.5px;}
.icard-eff{font-size:10px;color:var(--txs);text-align:center;line-height:1.3;}
.icard-rar{position:absolute;top:6px;right:6px;}

.add-item-btn{
  background:#fff;border:1.5px dashed var(--bord2);border-radius:9px;
  padding:12px 10px;cursor:pointer;
  display:flex;flex-direction:column;align-items:center;justify-content:center;
  min-height:130px;gap:5px;
  font-size:12px;font-weight:700;color:var(--txm);
  transition:all .15s;
}
.add-item-btn:hover{border-color:var(--g);color:var(--g);background:var(--gbg);}

/* 스프라이트 피커 */
.spgrid{
  display:grid;grid-template-columns:repeat(auto-fill,minmax(54px,1fr));
  gap:5px;max-height:200px;overflow-y:auto;
  background:var(--lift);border:1.5px solid var(--bord);border-radius:7px;padding:8px;
}
.spi{
  display:flex;flex-direction:column;align-items:center;gap:2px;
  cursor:pointer;padding:4px;border-radius:6px;
  border:1.5px solid transparent;transition:all .15s;
}
.spi:hover{border-color:var(--bord2);}
.spi.sel{border-color:var(--g);background:var(--gbg);}
.spi canvas{image-rendering:pixelated;width:36px;height:36px;}
.spi span{font-size:8px;font-family:var(--fm);color:var(--txm);text-align:center;line-height:1.1;max-width:52px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}

/* 아이템 상세 */
.dv-head{display:flex;gap:16px;align-items:flex-start;margin-bottom:16px;}
.dv-head canvas{image-rendering:pixelated;width:80px;height:80px;border:1.5px solid var(--bord);border-radius:8px;background:var(--lift);}
.dv-name{font-size:20px;font-weight:900;color:var(--tx);margin-bottom:2px;}
.dv-type{font-family:var(--fm);font-size:10px;color:var(--txm);letter-spacing:1px;text-transform:uppercase;margin-bottom:6px;}
.dv-sec{border-top:1px solid var(--bord);padding-top:10px;margin-top:10px;}
.dv-lbl{font-size:11px;font-weight:700;color:var(--txm);letter-spacing:.5px;text-transform:uppercase;margin-bottom:4px;}
.dv-val{font-size:13px;color:var(--tx);line-height:1.6;}
.who-chips{display:flex;flex-wrap:wrap;gap:5px;}
.who-chip{
  font-family:var(--fm);font-size:10px;
  background:var(--gbg);border:1px solid rgba(74,124,47,.2);
  border-radius:4px;padding:3px 8px;color:var(--g);
}
.rec-small{font-family:var(--fm);font-size:11px;color:var(--txs);line-height:1.8;}

/* ══════════════════════════════════
   조합 탭
══════════════════════════════════ */
.craft-layout{display:grid;grid-template-columns:1fr 340px;gap:16px;}
@media(max-width:720px){.craft-layout{grid-template-columns:1fr;}}

.rec-filters{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px;}
.rlist{display:flex;flex-direction:column;gap:8px;max-height:calc(100vh - 240px);overflow-y:auto;padding-right:4px;}
.rcount{font-family:var(--fm);font-size:11px;color:var(--txm);margin-bottom:10px;}

.rec-card{
  background:#fff;border:1.5px solid var(--bord);border-radius:9px;
  padding:13px 14px;box-shadow:var(--sh);transition:border-color .15s;
}
.rec-card:hover{border-color:var(--bord2);}
.rec-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:9px;}
.rec-result{font-size:14px;font-weight:700;color:var(--tx);}
.diff-badge{font-family:var(--fm);font-size:9px;font-weight:700;padding:2px 8px;border-radius:4px;letter-spacing:.5px;}
.diff-easy{background:var(--gbg);color:var(--g);border:1px solid rgba(74,124,47,.2);}
.diff-medium{background:var(--abg);color:var(--a);border:1px solid rgba(160,96,16,.2);}
.diff-hard{background:var(--rbg);color:var(--r);border:1px solid rgba(184,48,48,.2);}
.rec-mats{display:flex;gap:5px;flex-wrap:wrap;align-items:center;margin-bottom:9px;}
.mat-tag{
  font-family:var(--fm);font-size:10px;
  background:var(--lift);border:1px solid var(--bord);
  border-radius:4px;padding:3px 8px;color:var(--txs);
}
.mat-tag.tool{background:var(--abg);border-color:rgba(160,96,16,.2);color:var(--a);}
.mat-tag.result{background:var(--gbg);border-color:rgba(74,124,47,.2);color:var(--g);}
.mat-tag.owned{background:var(--gbg);border-color:var(--g);color:var(--g);}
.mat-tag.missing{background:var(--rbg);border-color:rgba(184,48,48,.2);color:var(--r);}
.rec-sep{color:var(--txw);font-size:11px;}
.rec-arrow{color:var(--g);font-size:13px;}
.rec-note{font-size:11px;color:var(--txm);margin-bottom:8px;line-height:1.5;}
.rec-foot{display:flex;gap:6px;}

/* 조합 시뮬레이터 */
.sim-box{
  background:#fff;border:1.5px solid var(--bord);border-radius:10px;
  padding:16px;box-shadow:var(--sh);position:sticky;top:0;
}
.sim-box .slbl-inner{font-size:11px;font-weight:700;color:var(--txm);letter-spacing:.5px;text-transform:uppercase;margin-bottom:10px;}
.char-sel-row{display:flex;align-items:center;gap:8px;margin-bottom:12px;}
.char-sel-row label{font-size:12px;font-weight:700;color:var(--txs);white-space:nowrap;}
.char-sel-row select{
  flex:1;background:#fff;border:1.5px solid var(--bord);border-radius:7px;
  color:var(--tx);font-family:var(--fn);font-size:12px;padding:6px 9px;outline:none;
}
.char-sel-row select:focus{border-color:var(--g);}
.mat-sel-row{display:flex;gap:6px;align-items:center;margin-bottom:7px;}
.mat-sel-lbl{font-family:var(--fm);font-size:10px;color:var(--txm);width:36px;text-align:right;flex-shrink:0;}
.mat-sel-row select{
  flex:1;background:#fff;border:1.5px solid var(--bord);border-radius:7px;
  color:var(--tx);font-family:var(--fn);font-size:12px;padding:6px 9px;outline:none;
}
.mat-sel-row select:focus{border-color:var(--g);}
.sim-result{
  background:var(--lift);border:1.5px solid var(--bord);border-radius:7px;
  padding:10px 12px;min-height:60px;margin-top:10px;
  font-size:12px;color:var(--txm);line-height:1.6;
}
.craft-exec-btn{
  width:100%;background:var(--g);color:#fff;border:none;border-radius:7px;
  font-family:var(--fn);font-weight:700;font-size:13px;
  padding:10px;cursor:pointer;margin-top:8px;
  transition:background .15s;
}
.craft-exec-btn:hover{background:var(--gl);}
.craft-exec-btn:disabled{background:var(--bord2);cursor:not-allowed;}

/* ══════════════════════════════════
   요리 탭
══════════════════════════════════ */
.cook-layout{display:grid;grid-template-columns:1fr 320px;gap:16px;}
@media(max-width:700px){.cook-layout{grid-template-columns:1fr;}}

.ck-list{display:flex;flex-direction:column;gap:8px;max-height:calc(100vh - 240px);overflow-y:auto;padding-right:4px;}
.ck-card{background:#fff;border:1.5px solid var(--bord);border-radius:9px;padding:13px 14px;box-shadow:var(--sh);}
.ck-card:hover{border-color:var(--bord2);}
.ck-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:8px;}
.ck-name{font-size:14px;font-weight:700;color:var(--tx);}
.ck-cat-badge{font-family:var(--fm);font-size:9px;font-weight:700;padding:2px 8px;border-radius:4px;letter-spacing:.5px;}
.ck-meal     {background:var(--abg);color:var(--a);border:1px solid rgba(160,96,16,.2);}
.ck-drink    {background:var(--bbg);color:var(--b);border:1px solid rgba(40,88,160,.2);}
.ck-preserved{background:var(--gbg);color:var(--g);border:1px solid rgba(74,124,47,.2);}
.ck-mats{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:8px;align-items:center;}
.ck-stats{display:flex;gap:5px;flex-wrap:wrap;}
.ck-stat{font-family:var(--fm);font-size:9px;padding:2px 7px;border-radius:4px;}
.cs-hp  {background:var(--gbg);color:var(--g);border:1px solid rgba(74,124,47,.15);}
.cs-hun {background:var(--abg);color:var(--a);border:1px solid rgba(160,96,16,.15);}
.cs-san {background:var(--bbg);color:var(--b);border:1px solid rgba(40,88,160,.15);}
.cs-neg {background:var(--rbg);color:var(--r);border:1px solid rgba(184,48,48,.15);}
.cs-kcal{background:var(--lift);color:var(--txm);border:1px solid var(--bord);}
.ck-foot{display:flex;gap:6px;margin-top:9px;}

/* 요리 시뮬레이터 */
.cook-sim{background:#fff;border:1.5px solid var(--bord);border-radius:10px;padding:16px;box-shadow:var(--sh);position:sticky;top:0;}
.tool-grid{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-bottom:12px;}
.tool-slot{
  background:var(--lift);border:1.5px solid var(--bord);border-radius:8px;
  padding:9px;text-align:center;cursor:pointer;transition:all .15s;
}
.tool-slot:hover{border-color:var(--bord2);}
.tool-slot.has{border-color:var(--a);background:var(--abg);}
.tool-slot.unavail{opacity:.35;cursor:not-allowed;}
.tool-slot canvas{image-rendering:pixelated;width:30px;height:30px;display:block;margin:0 auto 4px;}
.tool-slot span{font-family:var(--fm);font-size:9px;color:var(--txm);display:block;line-height:1.2;}
.tool-slot.has span{color:var(--a);}
.ing-slot select{
  width:100%;background:#fff;border:1.5px solid var(--bord);border-radius:7px;
  color:var(--tx);font-family:var(--fn);font-size:12px;
  padding:6px 9px;outline:none;margin-bottom:6px;
}
.ing-slot select:focus{border-color:var(--g);}

/* ══════════════════════════════════
   인벤토리 모달
══════════════════════════════════ */
.inv-modal-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;}
.inv-list{max-height:300px;overflow-y:auto;display:flex;flex-direction:column;gap:5px;}
.inv-row{
  display:flex;align-items:center;gap:8px;
  padding:7px 10px;background:var(--lift);
  border:1px solid var(--bord);border-radius:7px;
}
.inv-row canvas{image-rendering:pixelated;width:26px;height:26px;flex-shrink:0;}
.inv-row-name{flex:1;font-size:12px;font-weight:700;color:var(--tx);}
.inv-row-qty{font-family:var(--fm);font-size:12px;color:var(--g);font-weight:700;min-width:22px;text-align:center;}
.inv-row-btns{display:flex;gap:3px;}
.qty-btn{
  width:22px;height:22px;border:1.5px solid var(--bord);background:#fff;
  color:var(--txs);font-size:14px;cursor:pointer;border-radius:5px;
  display:flex;align-items:center;justify-content:center;
  transition:all .15s;font-family:var(--fn);
}
.qty-btn:hover{border-color:var(--g);color:var(--g);}
.qty-btn.minus:hover{border-color:var(--r);color:var(--r);}
.add-list{max-height:300px;overflow-y:auto;display:flex;flex-direction:column;gap:4px;}
.inv-srch{
  width:100%;background:#fff;border:1.5px solid var(--bord);border-radius:7px;
  color:var(--tx);font-family:var(--fn);font-size:12px;
  padding:7px 10px;outline:none;margin-bottom:7px;
}
.inv-srch:focus{border-color:var(--g);}
.inv-filter-row{display:flex;gap:4px;flex-wrap:wrap;margin-bottom:8px;}
.itf{
  font-size:10px;font-weight:700;padding:3px 8px;border-radius:5px;
  cursor:pointer;border:1px solid var(--bord);background:var(--lift);
  color:var(--txs);transition:all .15s;
}
.itf:hover,.itf.on{border-color:var(--g);color:var(--g);background:var(--gbg);}
.add-item-row{
  display:flex;align-items:center;gap:8px;
  padding:7px 10px;background:#fff;
  border:1.5px solid var(--bord);border-radius:7px;
  cursor:pointer;transition:all .15s;
}
.add-item-row:hover{border-color:var(--g);background:var(--gbg);}
.add-item-row canvas{image-rendering:pixelated;width:26px;height:26px;flex-shrink:0;}
.add-item-info{flex:1;}
.add-item-name{font-size:12px;font-weight:700;color:var(--tx);}
.add-item-type{font-family:var(--fm);font-size:9px;color:var(--txm);}
.add-item-plus{font-size:18px;color:var(--g);line-height:1;}

/* ══════════════════════════════════
   지도 탭
══════════════════════════════════ */
.map-controls{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:12px;align-items:center;}
.map-lbl{font-size:12px;font-weight:700;color:var(--txs);}
.zbtn{
  font-size:11px;font-weight:700;padding:6px 12px;border-radius:6px;
  cursor:pointer;border:1.5px solid var(--bord);background:#fff;
  color:var(--txs);transition:all .15s;
}
.zbtn:hover{border-color:var(--bord2);}
.zbtn.sel{background:var(--g);color:#fff;border-color:var(--g);}
.zbtn.clear{border-color:rgba(184,48,48,.3);color:var(--r);}
.zbtn.clear:hover{border-color:var(--r);background:var(--rbg);}

.mapbox{background:#fff;border:1.5px solid var(--bord);border-radius:10px;overflow:hidden;box-shadow:var(--sh);}
.mgrid{display:grid;grid-template-columns:repeat(10,1fr);gap:2px;padding:3px;}
.mcell{
  aspect-ratio:1;border-radius:3px;cursor:pointer;
  display:flex;align-items:center;justify-content:center;
  font-family:var(--fm);font-size:8px;color:rgba(255,255,255,.35);
  transition:opacity .15s;user-select:none;
}
.mcell:hover{opacity:.75;}
.z-safe   {background:#c8e8a0;border:1px solid #a0cc6c;}
.z-danger {background:#f8c0c0;border:1px solid #e88888;}
.z-unknown{background:var(--lift);border:1px solid var(--bord);}
.z-neutral{background:#fde8c0;border:1px solid #e8c070;}
.z-base   {background:#c0d8f8;border:1px solid #88aae0;}
.z-loot   {background:#e0c8f8;border:1px solid #b888e0;}
.mcell.z-safe   {color:rgba(40,80,0,.4);}
.mcell.z-danger {color:rgba(120,0,0,.4);}
.mcell.z-unknown{color:var(--txw);}
.mcell.z-neutral{color:rgba(100,60,0,.4);}
.mcell.z-base   {color:rgba(0,40,100,.4);}
.mcell.z-loot   {color:rgba(60,0,100,.4);}

.map-legend{display:flex;gap:12px;flex-wrap:wrap;margin-top:10px;}
.leg-item{display:flex;align-items:center;gap:5px;font-size:11px;color:var(--txs);}
.leg-dot{width:10px;height:10px;border-radius:2px;flex-shrink:0;}
.map-info{font-family:var(--fm);font-size:11px;color:var(--txm);margin-top:8px;min-height:18px;}
.room-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:8px;margin-top:14px;}
.room-card{background:#fff;border:1.5px solid var(--bord);border-radius:8px;padding:10px 12px;box-shadow:var(--sh);}
.room-name{font-size:13px;font-weight:700;color:var(--tx);margin-bottom:3px;}
.room-info{font-family:var(--fm);font-size:10px;color:var(--txm);line-height:1.5;}
</style>
</head>
<body>

<div class="app">

  <!-- ═══ SIDEBAR ═══ -->
  <aside class="sidebar">
    <div class="sb-header">
      <div class="sb-logo">Survival Log</div>
      <div class="sb-title"><em>백하</em>고등학교</div>
      <div class="sb-status"><span class="sb-dot"></span><span id="sbDate"></span></div>
    </div>

    <nav class="sb-nav">
      <div class="sb-section">관리</div>
      <button class="sb-item on" onclick="switchTab('chars',this)">
        <div class="sb-icon">👤</div>
        <span>생존자</span>
        <span class="sb-badge" id="badge-chars">0</span>
      </button>
      <button class="sb-item" onclick="switchTab('items',this)">
        <div class="sb-icon">🎒</div>
        <span>아이템 도감</span>
        <span class="sb-badge" id="badge-items">0</span>
      </button>

      <div class="sb-section">생존</div>
      <button class="sb-item" onclick="switchTab('craft',this)">
        <div class="sb-icon">🔧</div>
        <span>조합</span>
        <span class="sb-badge" id="badge-craft">0</span>
      </button>
      <button class="sb-item" onclick="switchTab('cook',this)">
        <div class="sb-icon">🍳</div>
        <span>요리</span>
        <span class="sb-badge" id="badge-cook">0</span>
      </button>

      <div class="sb-section">정보</div>
      <button class="sb-item" onclick="switchTab('map',this)">
        <div class="sb-icon">🗺</div>
        <span>구역 지도</span>
      </button>
    </nav>

    <div class="sb-footer">
      <div id="sbCount">캐릭터 0명 · 아이템 0종</div>
      <div style="margin-top:10px;padding-top:10px;border-top:1px solid rgba(255,255,255,.08);">
        <div style="font-size:9px;letter-spacing:1.5px;color:rgba(255,255,255,.25);margin-bottom:8px;font-family:var(--fm);">PLAYER FILTER</div>
        <select id="playerFilter" onchange="onPlayerFilterChange()" style="width:100%;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);border-radius:7px;color:#fff;font-family:var(--fn);font-size:12px;font-weight:500;padding:7px 10px;outline:none;cursor:pointer;appearance:auto;">
          <option value="all" style="background:#1a1c18;color:#fff;">전체 보기</option>
        </select>
        <div id="playerDots" style="display:flex;flex-wrap:wrap;gap:5px;margin-top:8px;"></div>
      </div>
    </div>
  </aside>

  <!-- ═══ MAIN ═══ -->
  <div class="main">

    <!-- 탑바 -->
    <div class="topbar">
      <div class="topbar-left">
        <div class="page-title" id="pageTitle">생존자</div>
        <div class="page-sub" id="pageSub">캐릭터 목록</div>
      </div>
      <div class="topbar-right">
        <div class="stat-chip" id="topChip">백하고등학교</div>
      </div>
    </div>

    <!-- 컨텐츠 -->
    <div class="content">

      <!-- 캐릭터 -->
      <div class="tab on" id="tab-chars">
        <div class="sec">
          <div class="sec-title">등록된 생존자</div>
          <div class="sec-line"></div>
          <button class="btn btn-p" style="margin-left:12px;" onclick="openAddChar()">+ 캐릭터 추가</button>
        </div>
        <div class="cgrid" id="cgrid"></div>
      </div>

      <!-- 아이템 -->
      <div class="tab" id="tab-items">
        <div class="item-toolbar">
          <input class="isrch" type="text" placeholder="아이템 검색..." id="isrch" oninput="renderItems()">
          <select class="isort" id="isort" onchange="renderItems()">
            <option value="name">이름순</option>
            <option value="rarity">희귀도순</option>
            <option value="type">분류순</option>
          </select>
        </div>
        <div class="item-toolbar" style="margin-top:-4px;">
          <button class="flt-btn on" onclick="setIF('all',this)">전체</button>
          <button class="flt-btn" onclick="setIF('weapon',this)">⚔ 무기</button>
          <button class="flt-btn" onclick="setIF('medical',this)">+ 의료</button>
          <button class="flt-btn" onclick="setIF('food',this)">▲ 식량</button>
          <button class="flt-btn" onclick="setIF('material',this)">◈ 재료</button>
          <button class="flt-btn" onclick="setIF('equipment',this)">◉ 장비</button>
          <span class="icount-txt" id="icount"></span>
        </div>
        <div class="igrid" id="igrid"></div>
      </div>

      <!-- 조합 -->
      <div class="tab" id="tab-craft">
        <div class="craft-layout">
          <div>
            <div class="rec-filters">
              <button class="flt-btn on" onclick="setRF('all',this)">전체</button>
              <button class="flt-btn" onclick="setRF('weapon',this)">무기</button>
              <button class="flt-btn" onclick="setRF('medical',this)">의료</button>
              <button class="flt-btn" onclick="setRF('equipment',this)">장비</button>
              <button class="flt-btn" onclick="setRF('trap',this)">함정</button>
              <button class="flt-btn" onclick="setRF('tool',this)">도구</button>
              <button class="flt-btn" onclick="setRF('other',this)">기타</button>
            </div>
            <div class="rcount" id="rcount"></div>
            <div class="rlist" id="rlist"></div>
          </div>
          <div>
            <div class="sim-box">
              <div class="slbl-inner">인벤토리 조합</div>
              <div class="char-sel-row">
                <label>캐릭터</label>
                <select id="craftChar" onchange="onCraftCharChange()"></select>
              </div>
              <div id="craftMatRows"></div>
              <button class="craft-exec-btn" id="craftBtn" onclick="doCraft()" disabled>조합 실행</button>
              <div class="sim-result" id="craftRes">캐릭터와 재료를 선택하세요.</div>
              <div style="margin-top:10px;">
                <button class="btn btn-s" style="width:100%;" onclick="openModal('recModal')">+ 조합법 추가</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 요리 -->
      <div class="tab" id="tab-cook">
        <div class="cook-layout">
          <div>
            <div class="rec-filters" style="margin-bottom:10px;">
              <button class="flt-btn on" onclick="setCF('all',this)">전체</button>
              <button class="flt-btn" onclick="setCF('meal',this)">식사</button>
              <button class="flt-btn" onclick="setCF('drink',this)">음료</button>
              <button class="flt-btn" onclick="setCF('preserved',this)">보존식</button>
            </div>
            <div class="rcount" id="ckcount"></div>
            <div class="ck-list" id="cklist"></div>
          </div>
          <div>
            <div class="cook-sim">
              <div class="slbl-inner">인벤토리 요리</div>
              <div class="char-sel-row" style="margin-bottom:12px;">
                <label>캐릭터</label>
                <select id="cookChar" onchange="onCookCharChange()"></select>
              </div>
              <div class="slbl-inner" style="margin-bottom:7px;">조리 도구</div>
              <div class="tool-grid" id="cookToolGrid"></div>
              <div class="slbl-inner" style="margin-bottom:6px;">재료 (최대 4개)</div>
              <div id="cookIngList"></div>
              <button class="craft-exec-btn" id="cookBtn" onclick="doCook()" disabled>요리 실행</button>
              <div class="sim-result" id="cookRes">캐릭터를 선택하세요.</div>
              <div style="margin-top:10px;">
                <button class="btn btn-s" style="width:100%;" onclick="openModal('ckModal')">+ 레시피 추가</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 지도 -->
      <div class="tab" id="tab-map">
        <!-- 층 탭 -->
        <div style="display:flex;gap:5px;flex-wrap:wrap;margin-bottom:12px;" id="floorTabs"></div>
        <!-- 상태 설정 툴바 -->
        <div class="map-controls" style="margin-bottom:10px;">
          <span class="map-lbl">상태 표시:</span>
          <button class="zbtn sel" onclick="selZ('z-safe',this)">안전</button>
          <button class="zbtn" onclick="selZ('z-danger',this)">위험</button>
          <button class="zbtn" onclick="selZ('z-neutral',this)">미탐사</button>
          <button class="zbtn" onclick="selZ('z-base',this)">거점</button>
          <button class="zbtn" onclick="selZ('z-loot',this)">루팅존</button>
          <button class="zbtn" onclick="selZ('z-unknown',this)">불명</button>
          <button class="zbtn clear" style="margin-left:auto;" onclick="clearFloorStatus()">이 층 초기화</button>
        </div>
        <!-- 캔버스 -->
        <div style="background:#fff;border:1.5px solid var(--bord);border-radius:10px;overflow:hidden;box-shadow:var(--sh);">
          <canvas id="fpCanvas" style="display:block;width:100%;cursor:default;"></canvas>
        </div>
        <!-- 구역 정보 -->
        <div id="fpDetail" style="margin-top:10px;padding:10px 14px;background:var(--lift);border:1.5px solid var(--bord);border-radius:8px;font-size:13px;color:var(--txs);min-height:38px;line-height:1.5;">
          구역을 클릭하면 정보가 표시됩니다.
        </div>
        <!-- 범례 -->
        <div style="display:flex;gap:14px;flex-wrap:wrap;margin-top:10px;align-items:center;">
          <div class="leg-item"><div class="leg-dot" style="background:#e8f4e8;border:1px solid #a8d4a8;"></div>일반</div>
          <div class="leg-item"><div class="leg-dot" style="background:#fef3e8;border:1px solid #f0c080;"></div>특수</div>
          <div class="leg-item"><div class="leg-dot" style="background:#e8f0fc;border:1px solid #a8c0e8;"></div>행정·정보</div>
          <div class="leg-item"><div class="leg-dot" style="background:#fce8e8;border:1px solid #e8a8a8;"></div>위험</div>
          <div class="leg-item"><div class="leg-dot" style="background:#f0e8fc;border:1px solid #c8a8e8;"></div>외부</div>
          <div style="margin-left:auto;display:flex;gap:10px;align-items:center;">
            <div class="leg-item"><div class="leg-dot" style="background:#c8e8a0;border:1px solid #a0cc6c;"></div>안전 표시</div>
            <div class="leg-item"><div class="leg-dot" style="background:#f8c0c0;border:1px solid #e88888;"></div>위험 표시</div>
            <div class="leg-item"><div class="leg-dot" style="background:#c0d8f8;border:1px solid #88aae0;"></div>거점 표시</div>
          </div>
        </div>
      </div>

    </div><!-- /content -->
  </div><!-- /main -->
</div><!-- /app -->

<!-- ═══ MODALS ═══ -->

<!-- 캐릭터 모달 -->
<div class="overlay" id="charModal">
  <div class="modal">
    <h3 id="charModalTitle">새 캐릭터</h3>
    <div class="fgr">
      <div class="fg"><label>이름</label><input id="cName" placeholder="캐릭터 이름"></div>
      <div class="fg"><label>플레이어</label>
        <select id="cPlayer" style="width:100%;">
          <option value="">-- 선택 --</option>
        </select>
        <div style="margin-top:5px;display:flex;gap:6px;align-items:center;">
          <input id="cPlayerNew" placeholder="새 플레이어 이름 직접 입력..." style="flex:1;padding:6px 10px;border:1.5px solid var(--bord);border-radius:6px;font-size:12px;color:var(--tx);background:#fff;outline:none;">
          <button type="button" class="btn-sm g" onclick="addNewPlayerToSelect()" style="white-space:nowrap;">추가</button>
        </div>
      </div>
    </div>
    <div class="fg"><label>동아리</label>
      <select id="cRole">
        <option>검도부</option><option>야구부</option><option>태권도부</option>
        <option>산악부</option><option>보건부</option><option>과학부</option>
        <option>요리부</option><option>방송부</option><option>도서부</option>
