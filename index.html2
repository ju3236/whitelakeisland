      [N,N,N,N,N,N,N,N,N,N,N,N,N,N,N,N],
      [N,N,N,N,N,N,N,N,N,N,N,N,N,N,N,N],
    ]);}},
  mop:{name:'대걸레',fn:c=>{
    // 긴 자루 + 아래 걸레 뭉치
    const P='#808080',PL='#b0b0b0',W='#e0d8b0',WD='#b0a870',B='#303030';
    px(c,[
      [N,N,N,N,N,N,N,N,N,N,N,N,N,PL,P,N],
      [N,N,N,N,N,N,N,N,N,N,N,N,PL,P,B,N],
