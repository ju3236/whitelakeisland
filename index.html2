      {id:'o_농구장',      x:398, y:118, w:96,  h:80,  name:'농구장',     cat:'outdoor', desc:'운동장 옆. 감염자 유입 경로 중 하나.'},
      {id:'o_수돗가',      x:502, y:118, w:98,  h:80,  name:'수돗가',     cat:'outdoor', desc:'물 수급 가능. 노출 공간. 교전 위험 높음.'},
      {id:'o_주차장',      x:20,  y:216, w:580, h:100, name:'주차장',     cat:'outdoor', desc:'차량 다수. 탈출 시 이동 수단 후보. 사방 노출.'},
      {id:'o_정문',        x:20,  y:328, w:580, h:50,  name:'정문·담장',  cat:'danger',  desc:'감염자 집결 구역. 봉쇄 구역. 절대 접근 금지.'},
    ]
  },
];

const FP_CAT = {
  normal:   {fill:'#e8f4e8', stroke:'#a8d4a8', tx:'#1a4a1a'},
  special:  {fill:'#fef3e8', stroke:'#f0c080', tx:'#4a2a00'},
  admin:    {fill:'#e8f0fc', stroke:'#a8c0e8', tx:'#0a2060'},
  danger:   {fill:'#fce8e8', stroke:'#e8a8a8', tx:'#4a0a0a'},
  outdoor:  {fill:'#f0e8fc', stroke:'#c8a8e8', tx:'#2a0a50'},
  corridor: {fill:'#f4f2ee', stroke:'#d0ccc4', tx:'#6a6460'},
};

const FP_STATUS_OVERLAY = {
  'z-safe':    'rgba(100,200,80,0.35)',
  'z-danger':  'rgba(220,60,60,0.35)',
  'z-neutral': 'rgba(220,160,40,0.28)',
  'z-base':    'rgba(60,120,220,0.32)',
  'z-loot':    'rgba(140,60,220,0.28)',
  'z-unknown': 'rgba(80,80,80,0.35)',
};

let fpFloor = FP_FLOORS[0];
let fpHovered = null;
let selZoneClass = 'z-safe';

function initFloorPlan() {
  const tabs = document.getElementById('floorTabs');
  tabs.innerHTML = '';
  FP_FLOORS.forEach((f,i) => {
    const btn = document.createElement('button');
    btn.className = 'zbtn' + (i===0?' sel':'');
    btn.textContent = f.label;
    btn.style.cssText = 'font-size:11px;padding:5px 11px;border-radius:20px;';
    btn.onclick = () => {
      fpFloor = f; fpHovered = null;
      document.querySelectorAll('#floorTabs .zbtn').forEach(b=>b.classList.remove('sel'));
      btn.classList.add('sel');
      document.getElementById('fpDetail').textContent = '구역을 클릭하면 정보가 표시됩니다.';
      drawFP();
    };
    tabs.appendChild(btn);
  });
  const cv = document.getElementById('fpCanvas');
  cv.addEventListener('mousemove', fpMouseMove);
  cv.addEventListener('mouseleave', () => { fpHovered = null; drawFP(); });
  cv.addEventListener('click', fpClick);
  drawFP();
  window.addEventListener('resize', drawFP);
}

function drawFP() {
  const cv = document.getElementById('fpCanvas');
  if (!cv) return;
  const dpr = window.devicePixelRatio || 1;
  const logW = cv.parentElement.clientWidth || 620;
  const ratio = logW / fpFloor.w;
  const logH = fpFloor.h * ratio;
  cv.style.width  = logW + 'px';
  cv.style.height = logH + 'px';
  cv.width  = Math.round(logW * dpr);
  cv.height = Math.round(logH * dpr);
  const ctx = cv.getContext('2d');
  ctx.setTransform(1,0,0,1,0,0);
  ctx.scale(dpr * ratio, dpr * ratio);
  ctx.clearRect(0, 0, fpFloor.w, fpFloor.h);

  // 배경
  ctx.fillStyle = '#f8f7f4';
  ctx.fillRect(0, 0, fpFloor.w, fpFloor.h);

  // 층 라벨
  ctx.font = '500 12px system-ui, sans-serif';
  ctx.fillStyle = '#8a8278';
  ctx.textAlign = 'left';
  ctx.fillText(fpFloor.label, 20, 34);
  ctx.strokeStyle = '#dedad2';
  ctx.lineWidth = 0.5;
  ctx.beginPath();ctx.moveTo(20,40);ctx.lineTo(fpFloor.w-20,40);ctx.stroke();

  fpFloor.rooms.forEach(r => {
    const c = FP_CAT[r.cat] || FP_CAT.normal;
    const isHov = fpHovered === r.id;
    const statusKey = mapData[fpFloor.id + '|' + r.id];

    // 기본 fill
    ctx.fillStyle = isHov ? c.stroke : c.fill;
    ctx.strokeStyle = c.stroke;
    ctx.lineWidth = isHov ? 1.5 : 0.5;
    fpRoundRect(ctx, r.x, r.y, r.w, r.h, 4);
    ctx.fill();
    ctx.stroke();

    // 상태 오버레이
    if (statusKey && FP_STATUS_OVERLAY[statusKey]) {
      ctx.fillStyle = FP_STATUS_OVERLAY[statusKey];
      fpRoundRect(ctx, r.x, r.y, r.w, r.h, 4);
      ctx.fill();
    }

    // 텍스트
    ctx.fillStyle = c.tx;
    ctx.textAlign = 'center';
    const cx = r.x + r.w / 2;
    const cy = r.y + r.h / 2;
    const name = r.name;

    if (r.w >= 90 && r.h >= 36) {
      ctx.font = '500 11px system-ui, sans-serif';
      // 긴 이름은 2줄로
      if (name.length > 6 && r.w < 160) {
        const mid = Math.ceil(name.length / 2);
        const line1 = name.slice(0, mid);
        const line2 = name.slice(mid);
        ctx.fillText(line1, cx, cy - 3);
        ctx.fillText(line2, cx, cy + 12);
      } else {
        ctx.fillText(name, cx, cy + 4);
      }
    } else if (r.w >= 50) {
      ctx.font = '400 10px system-ui, sans-serif';
      ctx.fillText(name.length > 5 ? name.slice(0,4)+'…' : name, cx, cy + 4);
    }
  });
}

function fpRoundRect(ctx, x, y, w, h, r) {
  ctx.beginPath();
  ctx.moveTo(x+r, y);
  ctx.lineTo(x+w-r, y); ctx.arcTo(x+w, y,   x+w, y+r,   r);
  ctx.lineTo(x+w, y+h-r); ctx.arcTo(x+w, y+h, x+w-r, y+h, r);
  ctx.lineTo(x+r, y+h); ctx.arcTo(x,   y+h, x,   y+h-r, r);
  ctx.lineTo(x, y+r);   ctx.arcTo(x,   y,   x+r, y,     r);
  ctx.closePath();
}

function fpGetRoom(ex, ey) {
  const cv = document.getElementById('fpCanvas');
  const logW = cv.clientWidth;
  const ratio = logW / fpFloor.w;
  const rx = ex / ratio, ry = ey / ratio;
  return fpFloor.rooms.find(r => rx>=r.x && rx<=r.x+r.w && ry>=r.y && ry<=r.y+r.h) || null;
}

function fpMouseMove(e) {
  const rect = e.currentTarget.getBoundingClientRect();
  const room = fpGetRoom(e.clientX - rect.left, e.clientY - rect.top);
  const newHov = room ? room.id : null;
  if (newHov !== fpHovered) { fpHovered = newHov; drawFP(); }
  e.currentTarget.style.cursor = room ? 'pointer' : 'default';
}

function fpClick(e) {
  const rect = e.currentTarget.getBoundingClientRect();
  const room = fpGetRoom(e.clientX - rect.left, e.clientY - rect.top);
  if (!room) return;
  const key = fpFloor.id + '|' + room.id;
  mapData[key] = selZoneClass;
  saveMapDB(key, selZoneClass);
  drawFP();
  const catLabel = {normal:'일반',special:'특수',admin:'행정·정보',danger:'위험',outdoor:'외부',corridor:'복도'};
  const statusLabel = {'z-safe':'안전','z-danger':'위험','z-neutral':'미탐사','z-base':'거점','z-loot':'루팅존','z-unknown':'불명'};
  document.getElementById('fpDetail').innerHTML =
    `<span style="font-weight:700;color:var(--tx);margin-right:8px;">${room.name}</span>` +
    `<span style="font-size:11px;color:var(--txm);margin-right:8px;">[${catLabel[room.cat]||room.cat}]</span>` +
    `<span style="font-size:11px;font-weight:700;color:var(--g);margin-right:10px;">→ ${statusLabel[selZoneClass]}</span>` +
    room.desc;
}

function selZ(z, btn) {
  selZoneClass = z;
  document.querySelectorAll('.zbtn:not(.clear)').forEach(b => b.classList.remove('sel'));
  btn.classList.add('sel');
}

function clearFloorStatus() {
  if (!confirm(`${fpFloor.label} 상태를 초기화할까요?`)) return;
  const delPromises = [];
  fpFloor.rooms.forEach(r => {
    const key = fpFloor.id + '|' + r.id;
    if (mapData[key]) {
      delPromises.push(sbDelete('map_status', {id: key}));
      delete mapData[key];
    }
  });
  Promise.all(delPromises).catch(e => toast('초기화 중 오류: '+e.message, true));
  lsave('mapData', mapData);
  drawFP();
  toast(`${fpFloor.label} 초기화됨`);
}


// ════════════════════════════════════════════
// MODAL
// ════════════════════════════════════════════
function openModal(id){
  if(id==='recModal')populateRecipeModal();
  if(id==='ckModal')populateCookModal();
  document.getElementById(id).classList.add('open');
}
function closeOverlays(){document.querySelectorAll('.overlay').forEach(m=>m.classList.remove('open'));}
document.querySelectorAll('.overlay').forEach(m=>m.addEventListener('click',e=>{if(e.target===m)closeOverlays();}));

// ════════════════════════════════════════════
// INIT
// ════════════════════════════════════════════
const now=new Date();
document.getElementById('sbDate').textContent=`DAY ??? · ${now.toLocaleDateString('ko-KR')}`;

(async()=>{
  await loadAll();
  renderChars();renderItems();renderRecipes();renderCook();initFloorPlan();updateHeader();
})();
</script>
</body>
</html>
