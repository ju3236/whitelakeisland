      <div class="fg"><label>근력 (1~5)</label><input type="number" id="cSTR" min="1" max="5" value="2"></div>
      <div class="fg"><label>민첩 (1~5)</label><input type="number" id="cSPD" min="1" max="5" value="2"></div>
    </div>
    <div style="font-size:11px;color:var(--txm);background:var(--lift);border-radius:7px;padding:8px 12px;margin-bottom:4px;">
      합계 <strong id="statSum" style="color:var(--g);">10</strong>점 (동아리 보너스 +1 별도, 제한 없음)
    </div>
    <div class="mact">
      <button class="btn btn-s" onclick="closeOverlays()">취소</button>
      <button class="btn btn-p" onclick="saveChar()">저장</button>
    </div>
  </div>
</div>

