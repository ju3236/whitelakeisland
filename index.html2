// SUPABASE CONFIG
// ════════════════════════════════════════════
const SB_URL  = 'https://qgjwohlzdbmmqjrdrzog.supabase.co';
const SB_KEY  = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFnandvaGx6ZGJtbXFqcmRyem9nIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzU1NjA2NzgsImV4cCI6MjA5MTEzNjY3OH0.42J8YtTRcJ8Sw7Jty9cTudznS0W-R_cWJLXQ9yXNIZU';
const SB_HDR  = {'Content-Type':'application/json','apikey':SB_KEY,'Authorization':'Bearer '+SB_KEY};

async function sbGet(table, params=''){
  const r = await fetch(`${SB_URL}/rest/v1/${table}?${params}`, {headers:SB_HDR});
  if(!r.ok) throw new Error(await r.text());
  return r.json();
}
async function sbUpsert(table, data){
  const r = await fetch(`${SB_URL}/rest/v1/${table}`, {
    method:'POST',
    headers:{...SB_HDR,'Prefer':'resolution=merge-duplicates'},
    body: JSON.stringify(Array.isArray(data)?data:[data])
  });
  if(!r.ok) throw new Error(await r.text());
}
async function sbDelete(table, match){
  const params = Object.entries(match).map(([k,v])=>`${k}=eq.${encodeURIComponent(v)}`).join('&');
  const r = await fetch(`${SB_URL}/rest/v1/${table}?${params}`, {
    method:'DELETE', headers:SB_HDR
  });
  if(!r.ok) throw new Error(await r.text());
}

// ════════════════════════════════════════════
// STATE
// ════════════════════════════════════════════
// 기본 아이템/조합법/요리는 코드에 내장 — 업데이트해도 유저 데이터 안 날아감
// 캐릭터·지도·유저추가데이터는 Supabase에 저장

let chars    = [];
let items    = [...DEFAULT_ITEMS];
let recipes  = [...DEFAULT_RECIPES];
let cookRecs = [...DEFAULT_COOK_RECIPES];
let mapData  = {};

// 로컬 캐시용 (오프라인 대비)
function lsave(k,v){try{localStorage.setItem('bh_'+k,JSON.stringify(v));}catch{}}
function lload(k,d){try{const v=localStorage.getItem('bh_'+k);return v?JSON.parse(v):d;}catch{return d;}}

function uid(p){return p+(Date.now().toString(36)+Math.random().toString(36).slice(2)).slice(0,8);}

// 로딩 오버레이
function showLoading(msg='불러오는 중...'){
  let el = document.getElementById('sbLoading');
  if(!el){
    el = document.createElement('div');
    el.id = 'sbLoading';
    el.style.cssText = 'position:fixed;inset:0;background:rgba(28,26,22,.75);z-index:500;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;';
    el.innerHTML = `<div style="width:36px;height:36px;border:3px solid rgba(255,255,255,.2);border-top-color:#a8c262;border-radius:50%;animation:spin .8s linear infinite;"></div><div style="color:#fff;font-size:13px;font-family:var(--fm);">${msg}</div>`;
    const style = document.createElement('style');
    style.textContent = '@keyframes spin{to{transform:rotate(360deg)}}';
    document.head.appendChild(style);
    document.body.appendChild(el);
  } else {
    el.querySelector('div+div').textContent = msg;
    el.style.display = 'flex';
  }
}
function hideLoading(){
  const el = document.getElementById('sbLoading');
  if(el) el.style.display = 'none';
}

// ── 전체 데이터 로드 ──
async function loadAll(){
  showLoading('백하고등학교 데이터 로딩 중...');
  try {
    // 캐릭터
    const dbChars = await sbGet('characters','order=created_at.asc');
    chars = dbChars.map(c=>({
      id: c.id, name: c.name, role: c.role, player: c.player,
      hp: c.hp, san: c.san, str: c.str, spd: c.spd,
      inventory: c.inventory || {}
    }));
    lsave('chars', chars);

    // 지도 상태
    const dbMap = await sbGet('map_status','');
    mapData = {};
    dbMap.forEach(r => { mapData[r.id] = r.status; });
    lsave('mapData', mapData);

    // 유저 추가 아이템/조합법/요리
    const [ci, cr, cc] = await Promise.all([
      sbGet('custom_items','order=created_at.asc'),
      sbGet('custom_recipes','order=created_at.asc'),
      sbGet('custom_cook','order=created_at.asc'),
    ]);
    // 기본 데이터 + 유저 추가 데이터 합치기
    const customItemIds = new Set(ci.map(x=>x.id));
    items = [...DEFAULT_ITEMS.filter(x=>!customItemIds.has(x.id)), ...ci.map(x=>({
      id:x.id, name:x.name, type:x.type, effect:x.effect,
      desc:x.description, rarity:x.rarity, sprite:x.sprite
    }))];
    const customRecIds = new Set(cr.map(x=>x.id));
    recipes = [...DEFAULT_RECIPES.filter(x=>!customRecIds.has(x.id)), ...cr.map(x=>({
      id:x.id, result:x.result, cat:x.cat, tool:x.tool,
      mat1:x.mat1, mat2:x.mat2, mat3:x.mat3, diff:x.diff, note:x.note
    }))];
    const customCookIds = new Set(cc.map(x=>x.id));
    cookRecs = [...DEFAULT_COOK_RECIPES.filter(x=>!customCookIds.has(x.id)), ...cc.map(x=>({
      id:x.id, name:x.name, cat:x.cat, tool:x.tool,
      ing1:x.ing1, ing2:x.ing2, ing3:x.ing3, effect:x.effect, cal:x.cal
    }))];

  } catch(e) {
    console.warn('Supabase 로드 실패, 로컬 캐시 사용:', e);
    chars    = lload('chars', DEFAULT_CHARS);
    mapData  = lload('mapData', {});
    toast('오프라인 상태 — 로컬 데이터를 불러왔습니다.', true);
  }
  hideLoading();
}

// ── 캐릭터 저장/삭제 ──
async function saveCharDB(c){
  try {
    await sbUpsert('characters', {
      id:c.id, name:c.name, role:c.role, player:c.player,
      hp:c.hp, san:c.san, str:c.str, spd:c.spd,
      inventory:c.inventory, updated_at: new Date().toISOString()
    });
    lsave('chars', chars);
  } catch(e){ toast('저장 실패: '+e.message, true); }
}
async function deleteCharDB(id){
  try { await sbDelete('characters',{id}); lsave('chars',chars); }
  catch(e){ toast('삭제 실패: '+e.message, true); }
}

// ── 인벤토리 저장 ──
async function saveInvDB(charId){
  const c = chars.find(x=>x.id===charId); if(!c) return;
  try {
    await sbUpsert('characters', {
      id:c.id, name:c.name, role:c.role, player:c.player,
      hp:c.hp, san:c.san, str:c.str, spd:c.spd,
      inventory:c.inventory, updated_at: new Date().toISOString()
    });
    lsave('chars', chars);
  } catch(e){ toast('인벤토리 저장 실패', true); }
}

// ── 지도 상태 저장 ──
async function saveMapDB(key, status){
  const [floorId, ...rest] = key.split('|');
  const roomId = rest.join('|');
  try {
    await sbUpsert('map_status', {
      id: key, floor_id: floorId, room_id: roomId,
      status, updated_at: new Date().toISOString()
    });
    lsave('mapData', mapData);
  } catch(e){ toast('지도 저장 실패', true); }
}

// ── 아이템 저장/삭제 ──
async function saveItemDB(it){
  try {
    await sbUpsert('custom_items', {
      id:it.id, name:it.name, type:it.type, effect:it.effect,
      description:it.desc||'', rarity:it.rarity, sprite:it.sprite
    });
  } catch(e){ toast('아이템 저장 실패', true); }
}
async function deleteItemDB(id){
  try { await sbDelete('custom_items',{id}); }
  catch(e){ /* 기본 아이템은 DB에 없으므로 무시 */ }
}

// ── 조합법 저장/삭제 ──
async function saveRecipeDB(r){
  try {
    await sbUpsert('custom_recipes',{
      id:r.id, result:r.result, cat:r.cat, tool:r.tool||'',
      mat1:r.mat1||'', mat2:r.mat2||'', mat3:r.mat3||'',
      diff:r.diff, note:r.note||''
    });
  } catch(e){ toast('조합법 저장 실패', true); }
}
async function deleteRecipeDB(id){
  try { await sbDelete('custom_recipes',{id}); }
  catch(e){ /* 기본 조합법은 DB에 없으므로 무시 */ }
}

// ── 요리 레시피 저장/삭제 ──
async function saveCookDB(r){
  try {
    await sbUpsert('custom_cook',{
      id:r.id, name:r.name, cat:r.cat, tool:r.tool||'',
      ing1:r.ing1||'', ing2:r.ing2||'', ing3:r.ing3||'',
      effect:r.effect||'', cal:r.cal||0
    });
  } catch(e){ toast('레시피 저장 실패', true); }
}
async function deleteCookDB(id){
  try { await sbDelete('custom_cook',{id}); }
  catch(e){ /* 기본 레시피는 DB에 없으므로 무시 */ }
}

// ── 호환성용 saveAll (로컬 캐시만) ──
function saveAll(){ lsave('chars',chars); lsave('mapData',mapData); }


// ════════════════════════════════════════════
// TOAST
// ════════════════════════════════════════════
let _tt;
function toast(msg,err=false){
  const t=document.getElementById('toast');
  t.textContent=msg;t.className='toast'+(err?' err':'');
  t.classList.add('show');clearTimeout(_tt);
  _tt=setTimeout(()=>t.classList.remove('show'),2800);
}

// ════════════════════════════════════════════
// HEADER / BADGES
// ════════════════════════════════════════════
function updateHeader(){
  document.getElementById('sbCount').textContent=`캐릭터 ${chars.length}명 · 아이템 ${items.length}종`;
  document.getElementById('badge-chars').textContent=chars.length;
  document.getElementById('badge-items').textContent=items.length;
  document.getElementById('badge-craft').textContent=recipes.length;
  document.getElementById('badge-cook').textContent=cookRecs.length;
  document.getElementById('topChip').textContent=`캐릭터 ${chars.length}명 · 아이템 ${items.length}종`;
}

// ════════════════════════════════════════════
// CHARACTERS
// ════════════════════════════════════════════
let charEditId=null;

function renderChars(){
  updatePlayerDropdown();
  const g=document.getElementById('cgrid');g.innerHTML='';
  const filtered = playerFilter==='all' ? chars : chars.filter(c=>c.player===playerFilter);
  filtered.forEach(c=>{
    const col=ROLE_C[c.role]||'#4a7c2f';
    const inv=c.inventory||{};
    const entries=Object.entries(inv).filter(([,q])=>q>0);
    function dots(val,cls){
      const v=Math.max(1,Math.min(5,Math.round(val)));
      return Array.from({length:5},(_,i)=>`<div class="dot5 ${cls}${i<v?' on':''}"></div>`).join('');
    }
    const bonus=ROLE_BONUS[c.role]||'?';
    const pc=getPlayerColor(c.player);
    const d=document.createElement('div');d.className='ccard';d.style.setProperty('--cbar',col);
    d.innerHTML=`
      <div class="ccard-stripe"></div>
      <div class="ccard-body">
        <div class="ccard-head">
          <div>
            <div class="cname">${c.name}</div>
            <div class="cplayer" style="display:flex;align-items:center;gap:5px;margin-top:2px;">
              <span style="display:inline-block;width:7px;height:7px;border-radius:50%;background:${pc};flex-shrink:0;"></span>
              <span>${c.player}</span>
            </div>
          </div>
          <div class="crole-badge" title="${ROLE_DESC[c.role]||''}" style="background:${col}18;color:${col};border:1.5px solid ${col}40;">${c.role}</div>
        </div>
        <div class="stats">
          <div class="stat-row">
            <div class="stat-top"><span class="stat-name">HP</span><span class="stat-num" style="color:var(--r)">${c.hp}${bonus==='HP'?'+':''}／5</span></div>
            <div class="stat-dots">${dots(c.hp,'hp')}</div>
          </div>
          <div class="stat-row">
            <div class="stat-top"><span class="stat-name">SAN</span><span class="stat-num" style="color:var(--b)">${c.san}${bonus==='SAN'?'+':''}／5</span></div>
            <div class="stat-dots">${dots(c.san,'san')}</div>
          </div>
          <div class="stat-row">
            <div class="stat-top"><span class="stat-name">STR</span><span class="stat-num" style="color:var(--g)">${c.str}${bonus==='STR'?'+':''}／5</span></div>
            <div class="stat-dots">${dots(c.str,'str')}</div>
          </div>
          <div class="stat-row">
            <div class="stat-top"><span class="stat-name">SPD</span><span class="stat-num" style="color:var(--a)">${c.spd}${bonus==='SPD'?'+':''}／5</span></div>
            <div class="stat-dots">${dots(c.spd,'spd')}</div>
          </div>
        </div>
      </div>
      <div class="cinv">
        <div class="cinv-head">
          <span class="cinv-lbl">인벤토리</span>
          <span class="cinv-count">${entries.reduce((a,[,q])=>a+q,0)}개</span>
        </div>
        <div class="cinv-slots">${entries.length
          ?entries.slice(0,7).map(([n,q])=>`<div class="inv-tag">${n}<span class="qty">×${q}</span></div>`).join('')+(entries.length>7?`<div class="inv-tag" style="color:var(--txm)">+${entries.length-7}</div>`:'')
          :'<span class="inv-empty">아이템 없음</span>'}</div>
      </div>
      <div class="ccard-foot">
        <button class="btn-sm g" onclick="openInvModal('${c.id}')">인벤토리</button>
        <button class="btn-sm"   onclick="openEditChar('${c.id}')">수정</button>
        <button class="btn-sm d" onclick="delChar('${c.id}')">삭제</button>
      </div>`;
    g.appendChild(d);
  });
  // 추가 버튼
  const ab=document.createElement('button');ab.className='add-char-btn';
  ab.innerHTML=`<div class="plus">+</div><div style="font-size:13px">캐릭터 추가</div>`;
  ab.onclick=openAddChar;g.appendChild(ab);
  updateHeader();
}

function populatePlayerSelect(selectedVal='') {
  const sel = document.getElementById('cPlayer');
  const cur = selectedVal || sel.value;
  sel.innerHTML = '<option value="">-- 선택 --</option>';
  const players = Array.from(new Set(chars.map(c=>c.player).filter(Boolean))).sort();
  players.forEach(p => {
    const o = document.createElement('option');
    o.value = p; o.textContent = p;
    if (p === cur) o.selected = true;
    sel.appendChild(o);
  });
  if (cur) sel.value = cur;
}

function addNewPlayerToSelect() {
  const nm = document.getElementById('cPlayerNew').value.trim();
  if (!nm) { toast('이름을 입력해주세요.', true); return; }
  document.getElementById('cPlayerNew').value = '';
  // 드롭다운에 새 옵션 직접 추가
  const sel = document.getElementById('cPlayer');
  const exists = Array.from(sel.options).some(o => o.value === nm);
  if (!exists) {
    const o = document.createElement('option');
    o.value = nm; o.textContent = nm;
    sel.appendChild(o);
  }
  sel.value = nm;
  toast(`"${nm}" 추가됨`);
}

function openAddChar(){
  charEditId=null;
  document.getElementById('charModalTitle').textContent='새 캐릭터';
  document.getElementById('cName').value='';
  populatePlayerSelect('');
  ['cHP','cSAN','cSTR','cSPD'].forEach(id=>document.getElementById(id).value=2);
  updateStatSum();openModal('charModal');
}
function openEditChar(id){
  const c=chars.find(x=>x.id===id);if(!c)return;
  charEditId=id;
  document.getElementById('charModalTitle').textContent='캐릭터 수정';
  document.getElementById('cName').value=c.name;
  document.getElementById('cRole').value=c.role;
  populatePlayerSelect(c.player);
  document.getElementById('cHP').value=Math.max(1,Math.min(5,c.hp));
  document.getElementById('cSAN').value=Math.max(1,Math.min(5,c.san));
  document.getElementById('cSTR').value=Math.max(1,Math.min(5,c.str));
  document.getElementById('cSPD').value=Math.max(1,Math.min(5,c.spd));
  updateStatSum();openModal('charModal');
}
function saveChar(){
  const nm=document.getElementById('cName').value.trim();if(!nm){toast('이름을 입력하세요.',true);return;}
  const clamp=v=>Math.max(1,Math.min(5,+v||1));
  const hp=clamp(document.getElementById('cHP').value),san=clamp(document.getElementById('cSAN').value),str=clamp(document.getElementById('cSTR').value),spd=clamp(document.getElementById('cSPD').value);
  if(hp+san+str+spd>20){toast('합계 20점을 초과할 수 없습니다.',true);return;}
  const player=document.getElementById('cPlayer').value.trim()||'미설정';
  const role=document.getElementById('cRole').value;
  if(charEditId){
    const c=chars.find(x=>x.id===charEditId);if(!c)return;
    Object.assign(c,{name:nm,role,player,hp,san,str,spd});
    saveCharDB(c);
  } else {
    const c={id:uid('c'),name:nm,role,player,hp,san,str,spd,inventory:{}};
    chars.push(c);
    saveCharDB(c);
  }
  closeOverlays();renderChars();toast('캐릭터 저장됨');
}
function delChar(id){
  const c=chars.find(x=>x.id===id);if(!c)return;
  if(!confirm(`"${c.name}" 캐릭터를 삭제할까요?`))return;
  chars=chars.filter(x=>x.id!==id);
  deleteCharDB(id);
  renderChars();toast('삭제됨');
}

// ════════════════════════════════════════════
// INVENTORY
// ════════════════════════════════════════════
let invCharId=null,invFilt='all';
function openInvModal(charId){
  invCharId=charId;const c=chars.find(x=>x.id===charId);if(!c)return;
  document.getElementById('invModalTitle').textContent=`${c.name} 인벤토리`;
  document.getElementById('invSrch').value='';invFilt='all';
  document.querySelectorAll('.itf').forEach(b=>b.classList.remove('on'));
  document.querySelector('.itf').classList.add('on');
  renderInvList();renderAddList();openModal('invModal');
}
function renderInvList(){
  const c=chars.find(x=>x.id===invCharId);if(!c)return;
  const inv=c.inventory||{};const el=document.getElementById('invList');el.innerHTML='';
  const entries=Object.entries(inv).filter(([,q])=>q>0);
  if(!entries.length){el.innerHTML='<div style="font-size:12px;color:var(--txm);padding:8px;">아이템 없음</div>';return;}
  entries.forEach(([nm,qty])=>{
    const it=items.find(x=>x.name===nm);
    const row=document.createElement('div');row.className='inv-row';
    const cv=makeSpr(it?.sprite||'');cv.style.cssText='image-rendering:pixelated;width:26px;height:26px;';
    row.appendChild(cv);
    row.innerHTML+=`<span class="inv-row-name">${nm}</span><span class="inv-row-qty">${qty}</span>`;
    const btns=document.createElement('div');btns.className='inv-row-btns';
    const p=document.createElement('button');p.className='qty-btn';p.textContent='+';p.onclick=()=>{inv[nm]=(inv[nm]||0)+1;saveInvDB(invCharId);renderInvList();renderChars();};
    const m=document.createElement('button');m.className='qty-btn minus';m.textContent='−';m.onclick=()=>{inv[nm]--;if(inv[nm]<=0)delete inv[nm];saveInvDB(invCharId);renderInvList();renderChars();};
    btns.appendChild(p);btns.appendChild(m);row.appendChild(btns);el.appendChild(row);
  });
}
function renderAddList(){
  const q=document.getElementById('invSrch').value.toLowerCase();
  const el=document.getElementById('addItemList');el.innerHTML='';
  items.filter(it=>(invFilt==='all'||it.type===invFilt)&&(it.name.toLowerCase().includes(q)||it.effect.toLowerCase().includes(q))).forEach(it=>{
    const row=document.createElement('div');row.className='add-item-row';
    const cv=makeSpr(it.sprite||'');cv.style.cssText='image-rendering:pixelated;width:26px;height:26px;';
    row.appendChild(cv);
    row.innerHTML+=`<div class="add-item-info"><div class="add-item-name">${it.name}</div><div class="add-item-type">${TYPE_LBL[it.type]} · ${it.effect}</div></div><span class="add-item-plus">+</span>`;
    row.onclick=()=>{
      const c=chars.find(x=>x.id===invCharId);if(!c)return;
      if(!c.inventory)c.inventory={};
      c.inventory[it.name]=(c.inventory[it.name]||0)+1;
      saveInvDB(invCharId);renderInvList();renderChars();toast(`${it.name} 추가됨`);
    };
    el.appendChild(row);
  });
}
function setInvF(f,btn){invFilt=f;document.querySelectorAll('.itf').forEach(b=>b.classList.remove('on'));btn.classList.add('on');renderAddList();}

// ════════════════════════════════════════════
// ITEMS
// ════════════════════════════════════════════
let curIF='all';
function renderItems(){
  const q=document.getElementById('isrch').value.toLowerCase();
  const sort=document.getElementById('isort').value;
  let fil=items.filter(it=>(curIF==='all'||it.type===curIF)&&(it.name.toLowerCase().includes(q)||it.effect.toLowerCase().includes(q)));
  if(sort==='rarity')fil.sort((a,b)=>RAR_ORD[b.rarity]-RAR_ORD[a.rarity]);
  else if(sort==='type')fil.sort((a,b)=>a.type.localeCompare(b.type));
  else fil.sort((a,b)=>a.name.localeCompare(b.name,'ko'));
  document.getElementById('icount').textContent=`${fil.length}/${items.length}개`;
  const g=document.getElementById('igrid');g.innerHTML='';
  fil.forEach(it=>{
    const card=document.createElement('div');card.className=`icard rar-${it.rarity}`;
    const cv=makeSpr(it.sprite||'');cv.style.cssText='image-rendering:pixelated;width:56px;height:56px;';card.appendChild(cv);
    if(it.rarity!=='common'){const rb=document.createElement('div');rb.className=`icard-rar rar-badge rb-${it.rarity}`;rb.textContent=RAR_LBL[it.rarity];card.appendChild(rb);}
    const nm=document.createElement('div');nm.className='icard-name';nm.textContent=it.name;card.appendChild(nm);
    const tp=document.createElement('div');tp.className='icard-type';tp.textContent=TYPE_LBL[it.type];card.appendChild(tp);
    const ef=document.createElement('div');ef.className='icard-eff';ef.textContent=it.effect;card.appendChild(ef);
    card.onclick=()=>openItemDetail(it);g.appendChild(card);
  });
  const ab=document.createElement('button');ab.className='add-item-btn';ab.innerHTML='<div style="font-size:22px;line-height:1">+</div><div>아이템 추가</div>';ab.onclick=openAddItem;g.appendChild(ab);
  updateHeader();
}
function setIF(f,btn){curIF=f;document.querySelectorAll('#tab-items .flt-btn').forEach(b=>b.classList.remove('on'));btn.classList.add('on');renderItems();}

function openAddItem(){
  document.getElementById('iName').value='';document.getElementById('iEffect').value='';
  document.getElementById('iDesc').value='';document.getElementById('iSprite').value='';
  buildSpGrid();openModal('itemModal');
}
function buildSpGrid(){
  const g=document.getElementById('spGrid');g.innerHTML='';
  Object.entries(SPRITES).forEach(([key,def])=>{
    const w=document.createElement('div');w.className='spi';
    const cv=makeSpr(key);cv.style.cssText='image-rendering:pixelated;width:36px;height:36px;';
    const lb=document.createElement('span');lb.textContent=def.name;
    w.appendChild(cv);w.appendChild(lb);
    w.onclick=()=>{document.querySelectorAll('.spi').forEach(p=>p.classList.remove('sel'));w.classList.add('sel');document.getElementById('iSprite').value=key;};
    g.appendChild(w);
  });
}
function saveItem(){
  const nm=document.getElementById('iName').value.trim();if(!nm){toast('이름을 입력하세요.',true);return;}
  const it={id:uid('i'),name:nm,type:document.getElementById('iType').value,effect:document.getElementById('iEffect').value||'효과 없음',desc:document.getElementById('iDesc').value||'',rarity:document.getElementById('iRarity').value,sprite:document.getElementById('iSprite').value||Object.keys(SPRITES)[0]};
  items.push(it);
  saveItemDB(it);
  closeOverlays();renderItems();toast('아이템 추가됨');
}
function openItemDetail(it){
  document.getElementById('dvName').textContent=it.name;
  document.getElementById('dvType').textContent=TYPE_LBL[it.type];
  const rb=document.getElementById('dvRar');rb.textContent=RAR_LBL[it.rarity];rb.className=`rar-badge rb-${it.rarity}`;
  document.getElementById('dvEffect').textContent=it.effect;
  document.getElementById('dvDesc').textContent=it.desc||'설명 없음';
  const dc=document.getElementById('dvCanvas');dc.width=16;dc.height=16;if(it.sprite)dc.getContext('2d').drawImage(makeSpr(it.sprite),0,0);
  const who=chars.filter(c=>(c.inventory||{})[it.name]>0);
  const whoSec=document.getElementById('dvWhoSec'),whoDiv=document.getElementById('dvWho');
  if(who.length){whoSec.style.display='';whoDiv.innerHTML=who.map(c=>`<div class="who-chip">${c.name} ×${c.inventory[it.name]}</div>`).join('');}
  else whoSec.style.display='none';
  const rel=recipes.filter(r=>r.mat1===it.name||r.mat2===it.name||r.mat3===it.name||r.result===it.name);
  const recSec=document.getElementById('dvRecSec'),recDiv=document.getElementById('dvRecs');
  if(rel.length){recSec.style.display='';recDiv.innerHTML=rel.map(r=>`${[r.mat1,r.mat2,r.mat3].filter(Boolean).join(' + ')} → <span style="color:var(--g);font-weight:700">${r.result}</span><br>`).join('');}
  else recSec.style.display='none';
  document.getElementById('dvDelBtn').onclick=()=>{if(confirm(`'${it.name}' 삭제?`)){items=items.filter(x=>x!==it);deleteItemDB(it.id);closeOverlays();renderItems();toast('삭제됨');}};
  openModal('itemDetail');
}

// ════════════════════════════════════════════
// CRAFTING
// ════════════════════════════════════════════
let curRF='all',craftCharId=null;
function setRF(f,btn){curRF=f;document.querySelectorAll('#tab-craft .flt-btn').forEach(b=>b.classList.remove('on'));btn.classList.add('on');renderRecipes();}
function renderRecipes(){
  const fil=curRF==='all'?recipes:recipes.filter(r=>r.cat===curRF);
  document.getElementById('rcount').textContent=`${fil.length}개의 조합법`;
  const l=document.getElementById('rlist');l.innerHTML='';
  const dm={easy:['쉬움','diff-easy'],medium:['보통','diff-medium'],hard:['어려움','diff-hard']};
  const c=chars.find(x=>x.id===craftCharId);const inv=c?(c.inventory||{}):{};
  fil.forEach(r=>{
    const[dl,dc]=dm[r.diff]||dm.medium;
    const mats=[r.mat1,r.mat2,r.mat3].filter(Boolean);
    const toolHtml=r.tool?`<span class="mat-tag tool">[${r.tool}]</span>`:'';
    const matsHtml=mats.map((m,i)=>{
      const has=craftCharId?(inv[m]>0):null;
      const cls=has===null?'mat-tag':has?'mat-tag owned':'mat-tag missing';
      return `${i>0?'<span class="rec-sep">+</span>':''}<span class="${cls}">${m}</span>`;
    }).join('');
    const d=document.createElement('div');d.className='rec-card';
    d.innerHTML=`
      <div class="rec-head"><div class="rec-result">${r.result}</div><span class="diff-badge ${dc}">${dl}</span></div>
      <div class="rec-mats">${toolHtml}${matsHtml}<span class="rec-arrow">→</span><span class="mat-tag result">${r.result}</span></div>
      ${r.note?`<div class="rec-note">${r.note}</div>`:''}
      <div class="rec-foot">
        ${craftCharId?`<button class="btn-sm g" onclick="quickCraft('${r.id}')">조합 실행</button>`:''}
        <button class="btn-sm d" onclick="delRec('${r.id}')">삭제</button>
      </div>`;
    l.appendChild(d);
  });
}
function delRec(id){if(!confirm('삭제?'))return;recipes=recipes.filter(x=>x.id!==id);deleteRecipeDB(id);renderRecipes();toast('삭제됨');}
function populateCraftUI(){
  const cs=document.getElementById('craftChar');cs.innerHTML='<option value="">-- 캐릭터 선택 --</option>';
  chars.forEach(c=>{const o=document.createElement('option');o.value=c.id;o.textContent=`${c.name} (${c.player})`;cs.appendChild(o);});
  if(craftCharId)cs.value=craftCharId;
  buildCraftMatRows();
}
function onCraftCharChange(){craftCharId=document.getElementById('craftChar').value||null;buildCraftMatRows();renderRecipes();}
function buildCraftMatRows(){
  const c=chars.find(x=>x.id===craftCharId);const inv=c?(c.inventory||{}):{};
  const ownedItems=c?Object.keys(inv).filter(k=>inv[k]>0):items.map(it=>it.name);
  const container=document.getElementById('craftMatRows');container.innerHTML='';
  ['도구','재료1','재료2','재료3'].forEach((lbl,i)=>{
    const row=document.createElement('div');row.className='mat-sel-row';
    const lb=document.createElement('span');lb.className='mat-sel-lbl';lb.textContent=lbl;
    const sel=document.createElement('select');sel.id=`cmat${i}`;
    sel.innerHTML='<option value="">없음</option>';
    (i===0?ownedItems.filter(nm=>nm.includes('버너')||nm.includes('냄비')||nm.includes('프라이팬')):ownedItems).forEach(nm=>{
      const o=document.createElement('option');o.value=nm;o.textContent=c?`${nm} ×${inv[nm]}`:nm;sel.appendChild(o);
    });
    sel.onchange=()=>checkCraftMatch();row.appendChild(lb);row.appendChild(sel);container.appendChild(row);
  });
  checkCraftMatch();
}
function checkCraftMatch(){
  const tool=document.getElementById('cmat0')?.value||'';
  const m1=document.getElementById('cmat1')?.value||'',m2=document.getElementById('cmat2')?.value||'',m3=document.getElementById('cmat3')?.value||'';
  const btn=document.getElementById('craftBtn');const res=document.getElementById('craftRes');
  if(!craftCharId||!m1){btn.disabled=true;res.textContent='캐릭터와 재료 1을 선택하세요.';return;}
  const inp=new Set([m1,m2,m3].filter(Boolean));
  const match=recipes.find(r=>{
    const need=new Set([r.mat1,r.mat2,r.mat3].filter(Boolean));
    if(need.size!==inp.size)return false;
    for(const x of need)if(!inp.has(x))return false;
    if(r.tool&&r.tool!==tool)return false;
    return true;
  });
  if(match){btn.disabled=false;btn.dataset.recId=match.id;res.innerHTML=`<span style="color:var(--g);font-weight:700">✓ ${match.result} 제작 가능</span>${match.note?`<br><span style="color:var(--txm);font-size:11px">${match.note}</span>`:''}`;
  } else {btn.disabled=true;btn.dataset.recId='';res.innerHTML=m1?'<span style="color:var(--r)">조합 실패. 맞는 조합법이 없습니다.</span>':'재료를 선택하세요.';}
}
function doCraft(){
  const recId=document.getElementById('craftBtn').dataset.recId;
  const rec=recipes.find(x=>x.id===recId);if(!rec||!craftCharId){toast('조합 불가.',true);return;}
  const c=chars.find(x=>x.id===craftCharId);if(!c)return;
  if(!c.inventory)c.inventory={};const inv=c.inventory;
  for(const m of[rec.mat1,rec.mat2,rec.mat3].filter(Boolean)){if(!inv[m]||inv[m]<=0){toast(`${m}이(가) 부족합니다.`,true);return;}}
  for(const m of[rec.mat1,rec.mat2,rec.mat3].filter(Boolean)){inv[m]--;if(inv[m]<=0)delete inv[m];}
  inv[rec.result]=(inv[rec.result]||0)+1;
  saveInvDB(craftCharId);renderChars();buildCraftMatRows();renderRecipes();
  document.getElementById('craftRes').innerHTML=`<span style="color:var(--g);font-weight:700">✓ ${rec.result}이(가) ${c.name}의 인벤토리에 추가됐습니다!</span>`;
  toast(`${rec.result} 조합 성공!`);
}
function quickCraft(recId){
  if(!craftCharId){toast('먼저 캐릭터를 선택하세요.',true);return;}
  const rec=recipes.find(x=>x.id===recId);if(!rec)return;
  const c=chars.find(x=>x.id===craftCharId);if(!c)return;
  if(!c.inventory)c.inventory={};const inv=c.inventory;
  for(const m of[rec.mat1,rec.mat2,rec.mat3].filter(Boolean)){if(!inv[m]||inv[m]<=0){toast(`${c.name}의 인벤토리에 ${m}이(가) 없습니다.`,true);return;}}
  for(const m of[rec.mat1,rec.mat2,rec.mat3].filter(Boolean)){inv[m]--;if(inv[m]<=0)delete inv[m];}
  inv[rec.result]=(inv[rec.result]||0)+1;
  saveInvDB(craftCharId);renderChars();renderRecipes();toast(`${c.name}: ${rec.result} 조합 성공!`);
}
function populateRecipeModal(){
  const allNames=items.map(it=>it.name);
  ['rM1','rM2','rM3'].forEach((id,i)=>{
    const s=document.getElementById(id);s.innerHTML=i===0?'<option value="">-- 선택 --</option>':'<option value="">없음</option>';
    allNames.forEach(nm=>{const o=document.createElement('option');o.value=nm;o.textContent=nm;s.appendChild(o);});
  });
  const ts=document.getElementById('rTool');ts.innerHTML='<option value="">없음</option>';
  items.filter(it=>it.name.includes('버너')||it.name.includes('냄비')||it.name.includes('팬')).forEach(it=>{const o=document.createElement('option');o.value=it.name;o.textContent=it.name;ts.appendChild(o);});
}
function saveRecipe(){
  const res=document.getElementById('rRes').value.trim(),m1=document.getElementById('rM1').value;
  if(!res||!m1){toast('결과물과 재료1을 입력하세요.',true);return;}
  const r={id:uid('r'),result:res,cat:document.getElementById('rCat').value,tool:document.getElementById('rTool').value,mat1:m1,mat2:document.getElementById('rM2').value,mat3:document.getElementById('rM3').value,diff:document.getElementById('rDiff').value,note:document.getElementById('rNote').value};
  recipes.push(r);
  saveRecipeDB(r);
  closeOverlays();renderRecipes();toast('조합법 추가됨');
}

// ════════════════════════════════════════════
// COOKING
// ════════════════════════════════════════════
let curCF='all',cookCharId=null,cookActiveTools=new Set();
function setCF(f,btn){curCF=f;document.querySelectorAll('#tab-cook .flt-btn').forEach(b=>b.classList.remove('on'));btn.classList.add('on');renderCook();}
function renderCook(){
  const fil=curCF==='all'?cookRecs:cookRecs.filter(r=>r.cat===curCF);
  document.getElementById('ckcount').textContent=`${fil.length}개의 레시피`;
  const l=document.getElementById('cklist');l.innerHTML='';
  const catMap={meal:['식사','ck-meal'],drink:['음료','ck-drink'],preserved:['보존식','ck-preserved']};
  const c=chars.find(x=>x.id===cookCharId);const inv=c?(c.inventory||{}):{};
  fil.forEach(r=>{
    const[cl,cc]=catMap[r.cat]||catMap.meal;
    const ings=[r.ing1,r.ing2,r.ing3].filter(Boolean);
    const canMake=cookCharId&&(!r.tool||cookActiveTools.has(r.tool))&&ings.every(i=>inv[i]>0);
    const d=document.createElement('div');d.className='ck-card';
    d.innerHTML=`
      <div class="ck-head"><div class="ck-name">${r.name}</div><span class="ck-cat-badge ${cc}">${cl}</span></div>
      <div class="ck-mats">${r.tool?`<span class="mat-tag tool">[${r.tool}]</span>`:''}${ings.map(i=>{const has=cookCharId?inv[i]>0:null;return `<span class="mat-tag${has===null?'':has?' owned':' missing'}">${i}</span>`;}).join('<span class="rec-sep">+</span>')}</div>
      <div class="ck-stats">${r.effect.split(',').map(e=>{const t=e.toLowerCase();const cls=t.includes('hp')?'cs-hp':t.includes('허기')?'cs-hun':t.includes('san')?'cs-san':'cs-neg';return `<span class="ck-stat ${cls}">${e.trim()}</span>`;}).join('')}<span class="ck-stat cs-kcal">${r.cal}kcal</span></div>
      <div class="ck-foot">${cookCharId?`<button class="btn-sm${canMake?' g':''}" ${canMake?'':'disabled'} onclick="quickCook('${r.id}')">${canMake?'요리 실행':'재료 부족'}</button>`:''}<button class="btn-sm d" onclick="delCook('${r.id}')">삭제</button></div>`;
    l.appendChild(d);
  });
}
function delCook(id){if(!confirm('삭제?'))return;cookRecs=cookRecs.filter(x=>x.id!==id);deleteCookDB(id);renderCook();toast('삭제됨');}
function populateCookUI(){
  const cs=document.getElementById('cookChar');cs.innerHTML='<option value="">-- 캐릭터 선택 --</option>';
  chars.forEach(c=>{const o=document.createElement('option');o.value=c.id;o.textContent=`${c.name} (${c.player})`;cs.appendChild(o);});
  if(cookCharId)cs.value=cookCharId;buildCookSimUI();
}
function onCookCharChange(){cookCharId=document.getElementById('cookChar').value||null;cookActiveTools=new Set();buildCookSimUI();renderCook();}
function buildCookSimUI(){
  const c=chars.find(x=>x.id===cookCharId);const inv=c?(c.inventory||{}):{};
  const tg=document.getElementById('cookToolGrid');tg.innerHTML='';
  COOK_TOOLS.forEach(tn=>{
    const sprKey=tn.includes('버너')?'portable_stove':'pot';
    const hasTool=c?inv[tn]>0:false;
    const slot=document.createElement('div');
    slot.className=`tool-slot${cookActiveTools.has(tn)?' has':''}${!hasTool&&cookCharId?' unavail':''}`;
    const cv=makeSpr(sprKey);cv.style.cssText='image-rendering:pixelated;width:30px;height:30px;display:block;margin:0 auto 4px;';
    const sp=document.createElement('span');sp.textContent=hasTool?tn:`${tn} (없음)`;
    slot.appendChild(cv);slot.appendChild(sp);
    if(hasTool||!cookCharId)slot.onclick=()=>{if(cookActiveTools.has(tn))cookActiveTools.delete(tn);else cookActiveTools.add(tn);buildCookSimUI();checkCookMatch();};
    tg.appendChild(slot);
  });
  const foodItems=c?Object.keys(inv).filter(k=>inv[k]>0):items.filter(it=>it.type==='food'||it.type==='material').map(it=>it.name);
  const il=document.getElementById('cookIngList');il.innerHTML='';
  for(let i=0;i<4;i++){
    const row=document.createElement('div');row.className='ing-slot';
    const sel=document.createElement('select');sel.id=`cking${i}`;
    sel.innerHTML='<option value="">없음</option>';
    foodItems.forEach(nm=>{const o=document.createElement('option');o.value=nm;o.textContent=c?`${nm} ×${inv[nm]}`:nm;sel.appendChild(o);});
    sel.onchange=checkCookMatch;row.appendChild(sel);il.appendChild(row);
  }
  checkCookMatch();
}
function checkCookMatch(){
  const ings=[];for(let i=0;i<4;i++){const v=document.getElementById(`cking${i}`)?.value;if(v)ings.push(v);}
  const btn=document.getElementById('cookBtn');const res=document.getElementById('cookRes');
  if(!cookCharId||!ings.length){btn.disabled=true;res.textContent='캐릭터와 재료를 선택하세요.';return;}
  const ingSet=new Set(ings);
  const matches=cookRecs.filter(r=>{
    const need=new Set([r.ing1,r.ing2,r.ing3].filter(Boolean));
    for(const x of need)if(!ingSet.has(x))return false;
    if(r.tool&&!cookActiveTools.has(r.tool))return false;
    return true;
  });
  if(matches.length){btn.disabled=false;btn.dataset.ckIds=matches.map(m=>m.id).join(',');res.innerHTML=matches.map(m=>`<div style="color:var(--g);font-weight:700;margin-bottom:2px">✓ ${m.name}</div><div style="color:var(--txm);font-size:11px">${m.effect} / ${m.cal}kcal</div>`).join('<hr style="border:none;border-top:1px solid var(--bord);margin:6px 0">');}
  else{btn.disabled=true;btn.dataset.ckIds='';res.innerHTML='<span style="color:var(--r)">만들 수 있는 요리가 없습니다.</span>';}
}
function doCook(){
  const ids=(document.getElementById('cookBtn').dataset.ckIds||'').split(',').filter(Boolean);
  if(!ids.length||!cookCharId){toast('요리 불가.',true);return;}
  const rec=cookRecs.find(x=>x.id===ids[0]);if(!rec)return;
  const c=chars.find(x=>x.id===cookCharId);if(!c)return;
  if(!c.inventory)c.inventory={};const inv=c.inventory;
  for(const ing of[rec.ing1,rec.ing2,rec.ing3].filter(Boolean)){if(!inv[ing]||inv[ing]<=0){toast(`${ing}이(가) 부족합니다.`,true);return;}}
  for(const ing of[rec.ing1,rec.ing2,rec.ing3].filter(Boolean)){inv[ing]--;if(inv[ing]<=0)delete inv[ing];}
  inv[rec.name]=(inv[rec.name]||0)+1;
  saveInvDB(cookCharId);renderChars();buildCookSimUI();renderCook();
  document.getElementById('cookRes').innerHTML=`<span style="color:var(--g);font-weight:700">✓ ${rec.name}이(가) ${c.name}의 인벤토리에 추가됐습니다!</span>`;
  toast(`${rec.name} 요리 성공!`);
}
function quickCook(recId){
  if(!cookCharId){toast('먼저 캐릭터를 선택하세요.',true);return;}
  const rec=cookRecs.find(x=>x.id===recId);if(!rec)return;
  const c=chars.find(x=>x.id===cookCharId);if(!c)return;
  if(!c.inventory)c.inventory={};const inv=c.inventory;
  if(rec.tool&&!inv[rec.tool]){toast(`${rec.tool}이(가) 없습니다.`,true);return;}
  for(const ing of[rec.ing1,rec.ing2,rec.ing3].filter(Boolean)){if(!inv[ing]||inv[ing]<=0){toast(`${c.name}의 인벤토리에 ${ing}이(가) 없습니다.`,true);return;}}
  for(const ing of[rec.ing1,rec.ing2,rec.ing3].filter(Boolean)){inv[ing]--;if(inv[ing]<=0)delete inv[ing];}
  inv[rec.name]=(inv[rec.name]||0)+1;
  saveInvDB(cookCharId);renderChars();renderCook();toast(`${c.name}: ${rec.name} 요리 성공!`);
}
function saveCook(){
  const nm=document.getElementById('ckName').value.trim();if(!nm){toast('요리 이름을 입력하세요.',true);return;}
  const m1=document.getElementById('ckM1').value;if(!m1){toast('재료 1을 선택하세요.',true);return;}
  const r={id:uid('ck'),name:nm,cat:document.getElementById('ckCat').value,tool:document.getElementById('ckTool').value,ing1:m1,ing2:document.getElementById('ckM2').value,ing3:document.getElementById('ckM3').value,effect:document.getElementById('ckEff').value||'',cal:+document.getElementById('ckCal').value||0};
  cookRecs.push(r);
  saveCookDB(r);
  closeOverlays();renderCook();toast('레시피 추가됨');
}

function populateCookModal(){
  const foodItems=items.filter(it=>it.type==='food'||it.type==='material').map(it=>it.name);
  ['ckM1','ckM2','ckM3'].forEach((id,i)=>{
    const s=document.getElementById(id);s.innerHTML=i===0?'<option value="">-- 선택 --</option>':'<option value="">없음</option>';
    foodItems.forEach(nm=>{const o=document.createElement('option');o.value=nm;o.textContent=nm;s.appendChild(o);});
  });
  const ts=document.getElementById('ckTool');ts.innerHTML='<option value="">없음 (생식)</option>';
  COOK_TOOLS.forEach(tn=>{const o=document.createElement('option');o.value=tn;o.textContent=tn;ts.appendChild(o);});
}

