      [B,B,N,N,N,N,N,N,N,N,N,N,N,N,N,N],
    ]);}},
  fire_ext:{name:'소화기',fn:c=>{
    // 원통형 빨간 소화기, 위에 노즐/손잡이
    const R='#c83030',RL='#e05050',RD='#902020',G='#808080',GL='#b0b0b0',B='#181818',Y='#e0c020';
