<!-- ═══ JS (기존 로직 전체) ═══ -->
<script>
// ════════════════════════════════════════════
// PLAYER FILTER
// ════════════════════════════════════════════
let playerFilter = 'all';

const PLAYER_COLORS = ['#4a7c2f','#2858a0','#a06010','#7040a8','#b83030','#0f6e56'];

function getPlayerColor(playerName) {
  const players = Array.from(new Set(chars.map(c=>c.player).filter(Boolean))).sort();
  const idx = players.indexOf(playerName);
  return PLAYER_COLORS[idx % PLAYER_COLORS.length] || '#888';
}

function updatePlayerDropdown() {
  const sel = document.getElementById('playerFilter');
  const cur = sel.value;
  sel.innerHTML = '';

  const allOpt = document.createElement('option');
  allOpt.value = 'all';
  allOpt.textContent = '전체 보기 (' + chars.length + '명)';
  sel.appendChild(allOpt);

  const players = Array.from(new Set(chars.map(c=>c.player).filter(Boolean))).sort();
  players.forEach(p => {
    const o = document.createElement('option');
    o.value = p;
    const count = chars.filter(c=>c.player===p).length;
    o.textContent = `${p}  (${count}명)`;
    if (p === cur) o.selected = true;
    sel.appendChild(o);
  });

  const dots = document.getElementById('playerDots');
  if (dots) {
    dots.innerHTML = '';
    players.forEach(p => {
      const pc = getPlayerColor(p);
      const count = chars.filter(c=>c.player===p).length;
      const btn = document.createElement('button');
      btn.style.cssText = `display:flex;align-items:center;gap:4px;background:${playerFilter===p?'rgba(255,255,255,.15)':'rgba(255,255,255,.06)'};border:1px solid ${playerFilter===p?'rgba(255,255,255,.3)':'rgba(255,255,255,.1)'};border-radius:20px;padding:3px 8px;cursor:pointer;color:rgba(255,255,255,.8);font-size:11px;font-family:var(--fn);transition:all .15s;`;
      btn.innerHTML = `<span style="width:6px;height:6px;border-radius:50%;background:${pc};display:inline-block;flex-shrink:0;"></span>${p} <span style="opacity:.5;">${count}</span>`;
      btn.onclick = () => { document.getElementById('playerFilter').value = p; onPlayerFilterChange(); };
      dots.appendChild(btn);
    });
  }
}

function onPlayerFilterChange() {
  playerFilter = document.getElementById('playerFilter').value;
  renderChars();
}


const PAGE_META = {
  chars:  {title:'생존자',    sub:'캐릭터 목록'},
  items:  {title:'아이템 도감',sub:'발견된 아이템'},
  craft:  {title:'조합',      sub:'제작 레시피'},
  cook:   {title:'요리',      sub:'조리 레시피'},
  map:    {title:'구역 지도', sub:'백하고등학교'},
};
function switchTab(t, btn) {
  document.querySelectorAll('.tab').forEach(p=>p.classList.remove('on'));
  document.querySelectorAll('.sb-item').forEach(b=>b.classList.remove('on'));
  document.getElementById('tab-'+t).classList.add('on');
  btn.classList.add('on');
  const m = PAGE_META[t]||{};
  document.getElementById('pageTitle').textContent = m.title||'';
  document.getElementById('pageSub').textContent   = m.sub||'';
  if(t==='craft'){populateCraftUI();renderRecipes();}
  if(t==='cook'){populateCookUI();renderCook();}
  if(t==='items')renderItems();
  if(t==='map'){setTimeout(drawFP,50);}
  updateHeader();
}

// 스탯 합계 실시간 표시
['cHP','cSAN','cSTR','cSPD'].forEach(id=>{
  const el = document.getElementById(id);
  if(el) el.addEventListener('input', updateStatSum);
});
function updateStatSum(){
  const sum = ['cHP','cSAN','cSTR','cSPD'].reduce((a,id)=>{
    const v = Math.max(1,Math.min(5,+document.getElementById(id).value||1));
    return a+v;
  },0);
  const el = document.getElementById('statSum');
  if(el){ el.textContent = sum; el.style.color = 'var(--g)'; }
}

</script>
<script>
// ════════════════════════════════════════════
// PIXEL ART SPRITES (기존 그대로)
// ════════════════════════════════════════════
const N=null;
function px(ctx,d){d.forEach((r,y)=>r.forEach((c,x)=>{if(c){ctx.fillStyle=c;ctx.fillRect(x,y,1,1);}}));}
const SPRITES={
  baseball_bat:{name:'야구방망이',fn:c=>{
    // 굵은 타격부 위쪽, 가는 손잡이 아래쪽 대각선
    const H='#5a3010',M='#a06030',L='#d08848',S='#7a4820';
    px(c,[
      [N,N,N,N,N,N,N,N,N,N,N,N,H,H,N,N],
      [N,N,N,N,N,N,N,N,N,N,N,H,L,M,H,N],
      [N,N,N,N,N,N,N,N,N,N,H,L,L,M,H,N],
      [N,N,N,N,N,N,N,N,N,H,L,L,M,H,N,N],
      [N,N,N,N,N,N,N,N,H,L,L,M,H,N,N,N],
      [N,N,N,N,N,N,N,H,M,L,M,H,N,N,N,N],
      [N,N,N,N,N,N,H,M,S,M,H,N,N,N,N,N],
      [N,N,N,N,N,H,S,S,M,H,N,N,N,N,N,N],
      [N,N,N,N,H,S,S,M,H,N,N,N,N,N,N,N],
      [N,N,N,H,S,S,M,H,N,N,N,N,N,N,N,N],
      [N,N,H,S,S,S,H,N,N,N,N,N,N,N,N,N],
      [N,H,S,S,H,N,N,N,N,N,N,N,N,N,N,N],
      [H,S,S,H,N,N,N,N,N,N,N,N,N,N,N,N],
      [H,S,H,N,N,N,N,N,N,N,N,N,N,N,N,N],
      [H,H,N,N,N,N,N,N,N,N,N,N,N,N,N,N],
      [N,N,N,N,N,N,N,N,N,N,N,N,N,N,N,N],
    ]);}},
  chair_leg:{name:'의자 다리',fn:c=>{
    // 직사각형 금속봉, 양끝 끊김
    const M='#a09080',L='#c8b8a8',D='#706050',B='#302820';
    px(c,[
      [N,N,N,N,N,N,N,N,N,N,N,N,N,B,B,N],
      [N,N,N,N,N,N,N,N,N,N,N,N,B,L,M,B],
